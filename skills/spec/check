# Driver
# ---------------------------------------------------------------------------

def check_spec(spec, as_status=None):
    """Return (status_checked, [Problem])."""
    problems = []
    claimed = spec.status
    status = as_status or claimed
    rule_ids = list(STATUS_RULES.get(status, FRONTMATTER_RULES))
    if as_status and as_status != claimed:
        rule_ids = [r for r in rule_ids if r not in ACCEPTANCE_RECORD_RULES]
    if status not in STATUS_RULES and "frontmatter.status" not in rule_ids:
        rule_ids.append("frontmatter.status")
    for rule_id in rule_ids:
        severity = BUDGET_SEVERITY.get(status, "warning") if rule_id == "budget" else "error"
        for line, section, message, fix in RULES[rule_id](spec):
            problems.append(Problem(severity, line, section, rule_id, message, fix))
    problems.sort(key=lambda p: (p.line, p.rule))
    return status, problems


def format_problem(path, p):
    fix = p.fix[0].upper() + p.fix[1:]
    return "%s:%d: %s [%s] %s: %s. Fix: %s." % (path, p.line, p.severity, p.rule, p.section, p.message, fix)


USAGE = "usage: check [--as idea|draft|accepted] <spec.md> [<spec.md> ...] | check --rules"


def print_rules():
    for status in STATUSES:
        print("%s:" % status)
        for rule_id in STATUS_RULES[status]:
            severity = BUDGET_SEVERITY[status] if rule_id == "budget" else "error"
            print("  %-24s %-7s %s" % (rule_id, severity, RULE_TEXT[rule_id]))


def parse_args(argv):
    as_status, paths, i = None, [], 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            return "help", None
        if arg == "--rules":
            return "rules", None
        if arg == "--as" or arg.startswith("--as="):
            if arg == "--as":
                i += 1
                if i >= len(argv):
                    raise UsageError("--as needs a status")
                value = argv[i]
            else:
                value = arg[len("--as="):]
            if value not in ("idea", "draft", "accepted"):
                raise UsageError("--as must be idea, draft or accepted, not %r" % value)
            as_status = value
        elif arg == "--":
            paths.extend(argv[i + 1:])
            break
        elif arg.startswith("-") and arg != "-":
            raise UsageError("unknown option %r" % arg)
        else:
            paths.append(arg)
        i += 1
    if not paths:
        raise UsageError("no spec files given")
    return as_status, paths


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        as_status, paths = parse_args(argv)
    except UsageError as e:
        sys.stderr.write("check: %s\n%s\n" % (e, USAGE))
        return 2
    if as_status == "help":
        sys.stdout.write(__doc__.lstrip())
        return 0
    if as_status == "rules":
        print_rules()
        return 0
    worst = 0
    for path in paths:
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            print("%s:1: error [usage] file: can't read the file (%s). Fix: Pass the path to a spec .md file." % (path, e))
            worst = 2
            continue
        try:
            spec = Spec(path, text)
        except ParseError as e:
            print("%s:%d: error [parse] %s: %s. Fix: Correct the file so it parses." % (path, e.line, e.where, e.message))
            worst = 2
            continue
        status, problems = check_spec(spec, as_status)
        for p in problems:
            print(format_problem(path, p))
        errors = sum(1 for p in problems if p.severity == "error")
        warnings = len(problems) - errors
        if errors:
            worst = max(worst, 1)
        else:
            label = status if not as_status or as_status == spec.status else "%s, checked as %s" % (spec.status, status)
            print("%s: ok (%s)%s" % (path, label, ", %d warning%s" % (warnings, "" if warnings == 1 else "s") if warnings else ""))
    return worst


if __name__ == "__main__":
    sys.exit(main())
