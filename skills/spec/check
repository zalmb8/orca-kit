Problem = namedtuple("Problem", "severity line section rule message fix")
Line = namedtuple("Line", "no text code")


class Section(object):
    def __init__(self, title, line):
        self.title = title
        self.line = line
        self.lines = []  # Line tuples, excluding the heading

    def text_lines(self):
        """Non-blank lines outside code fences."""
        return [ln for ln in self.lines if not ln.code and ln.text.strip()]


class Item(object):
    """A top-level `- ` list item and its indented continuation lines."""

    def __init__(self, line):
        self.line = line
        self.children = []


class ParseError(Exception):
    def __init__(self, line, message, where="frontmatter"):
        Exception.__init__(self, message)
        self.line = line
        self.message = message
        self.where = where


class UsageError(Exception):
    pass


# ---------------------------------------------------------------------------
# Parsing
# ---------------------------------------------------------------------------

def parse_scalar(raw, lineno):
    """Parse one frontmatter value: plain, "double-quoted" or 'single-quoted'.

    Only flat `key: value` scalars are accepted. Anything else YAML could mean
    (lists, maps, anchors, block scalars) is a parse error.
    """
    value = raw.strip()
    if value.startswith('"'):
        m = re.match(r'"((?:[^"\\]|\\.)*)"\s*(?:#.*)?$', value)
        if not m:
            raise ParseError(lineno, "unterminated or malformed double-quoted value")
        return re.sub(r"\\(.)", r"\1", m.group(1))
    if value.startswith("'"):
        m = re.match(r"'((?:[^']|'')*)'\s*(?:#.*)?$", value)
        if not m:
            raise ParseError(lineno, "unterminated or malformed single-quoted value")
        return m.group(1).replace("''", "'")
    if value.startswith("#"):
        return ""
    value = re.split(r"\s+#", value, 1)[0].strip()
    if value and value[0] in "[]{}&*!|>%@`-,?":
        raise ParseError(
            lineno,
            "unsupported value %r: only plain or quoted single-line values are allowed; quote it" % value,
        )
    if ": " in value or value.endswith(":"):
        raise ParseError(lineno, "value %r contains ': '; put it in quotes" % value)
    return value


def parse_frontmatter(lines):
    """Return (fields, field_lines, index_of_first_body_line)."""
    if not lines or lines[0].rstrip() != "---":
        raise ParseError(1, "the file must start with a '---' frontmatter line")
    fields, field_lines = {}, {}
    for i in range(1, len(lines)):
        lineno, raw = i + 1, lines[i].rstrip("\n").rstrip("\r")
        if raw.rstrip() == "---":
            return fields, field_lines, i + 1
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        m = FM_LINE_RE.fullmatch(raw.rstrip())
        if not m:
            raise ParseError(lineno, "malformed frontmatter line %r; expected a flat 'key: value'" % raw)
        key = m.group(1)
        if key in fields:
            raise ParseError(lineno, "duplicate frontmatter key %r (first on line %d)" % (key, field_lines[key]))
        fields[key] = parse_scalar(m.group(2) or "", lineno)
        field_lines[key] = lineno
    raise ParseError(1, "the frontmatter is never closed by a '---' line")


def split_sections(lines, first):
    """Split the body into `##` sections, tracking code fences."""
    preamble = Section("(before the first heading)", first + 1)
    sections, current, fence, fence_line = [], preamble, None, 0
    for i in range(first, len(lines)):
        lineno, text = i + 1, lines[i].rstrip("\n").rstrip("\r")
        m = FENCE_RE.match(text)
        if fence:
            current.lines.append(Line(lineno, text, True))
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
                fence = None
            continue
        if m:
            fence, fence_line = m.group(1), lineno
            current.lines.append(Line(lineno, text, True))
            continue
        h = H2_RE.match(text)
        if h:
            current = Section(h.group(1), lineno)
            sections.append(current)
            continue
        current.lines.append(Line(lineno, text, False))
    if fence:
        raise ParseError(fence_line, "code fence opened here is never closed", "body")
    return preamble, sections


def items(lines):
    """Group lines into top-level `- ` items; return (items, other_lines).

    Indented lines continue the item above. Blank lines don't end an item.
    Other non-blank, non-indented lines are returned in other_lines.
    """
    result, other, current = [], [], None
    for ln in lines:
        if not ln.text.strip():
            continue
        if ln.code or ln.text[0] in " \t":
            if current:
                current.children.append(ln)
            elif not ln.code:
                other.append(ln)
            continue
        if ITEM_RE.match(ln.text):
            current = Item(ln)
            result.append(current)
        else:
            current = None
            other.append(ln)
    return result, other


def strip_code(text):
    return INLINE_CODE_RE.sub("", text)


def child_value(item, label):
    """Return the (line, value) of an item's indented `label:` line, or None."""
    for ln in item.children:
        m = re.match(r"^\s+%s:\s*(.*)$" % re.escape(label), ln.text)
        if m and not ln.code:
            return ln, m.group(1).strip()
    return None


def table_cells(text):
    cells = re.split(r"(?<!\\)\|", text.strip())
    if cells and cells[0].strip() == "":
        cells = cells[1:]
    if cells and cells[-1].strip() == "":
        cells = cells[:-1]
    return [c.strip() for c in cells]


def is_separator(cells):
    return bool(cells) and all(re.fullmatch(r":?-{3,}:?", c) for c in cells)


class Spec(object):
    def __init__(self, path, text):
        self.path = path
        if text.startswith("\ufeff"):
            text = text[1:]
        self.lines = text.split("\n")
        if self.lines and self.lines[-1] == "":
            self.lines.pop()
        self.fields, self.field_lines, first = parse_frontmatter(self.lines)
        self.preamble, self.sections = split_sections(self.lines, first)
        self.by_title = {}
        for s in self.sections:
            self.by_title.setdefault(s.title, s)
        self.status = self.fields.get("status", "")
        self._behavior = None

    def section(self, title):
        return self.by_title.get(title)

    def all_lines(self):
        for ln in self.preamble.lines:
            yield None, ln
        for s in self.sections:
            yield s, Line(s.line, "## " + s.title, False)
            for ln in s.lines:
                yield s, ln

    def behavior(self):
        """Parse Behavior & Edge Cases into ACs, tables and stray lines."""
        if self._behavior is None:
            sec = self.section(BEHAVIOR)
            acs, tables, stray, malformed = [], [], [], []
            if sec:
                all_items, other = items(sec.lines)
                for it in all_items:
                    m = AC_RE.match(it.line.text)
                    if m:
                        acs.append((int(m.group(1)), it))
                    elif AC_LIKE_RE.match(it.line.text):
                        malformed.append(it.line)
                    else:
                        stray.append(it.line)
                table = None
                for ln in other:
                    if ln.text.startswith("|"):
                        if table is None or table[-1].no != ln.no - 1:
                            table = []
                            tables.append(table)
                        table.append(ln)
                        continue
                    table = None
                    if ln.text.startswith("Not applicable:") or ln.text.startswith("TBD"):
                        continue
                    stray.append(ln)
            self._behavior = (sec, acs, tables, stray, malformed)
        return self._behavior


# ---------------------------------------------------------------------------
# Rules. Each takes a Spec and yields (line, section, message, fix).
# ---------------------------------------------------------------------------

RULES = {}


def rule(rule_id):
    def register(fn):
        RULES[rule_id] = fn
        return fn
    return register


def fm_line(spec, key):
    return spec.field_lines.get(key, 1)


@rule("frontmatter.fields")
def check_fields(spec):
    for key in FIELDS:
        if key not in spec.fields:
            yield 1, "frontmatter", "missing field %r" % key, "add a '%s:' line to the frontmatter, as in the template" % key
        elif key in REQUIRED_VALUES and not spec.fields[key]:
            yield fm_line(spec, key), "frontmatter", "%r is empty" % key, "give %s a value" % key


@rule("frontmatter.id")
def check_id(spec):
    name = os.path.basename(spec.path)
    stem, ext = os.path.splitext(name)
    sid = spec.fields.get("id", "")
    if ext != ".md":
        yield 1, "frontmatter", "file name %r doesn't end in .md" % name, "rename the file to <id>.md"
    if sid and not SLUG_RE.fullmatch(sid):
        yield fm_line(spec, "id"), "frontmatter", "id %r is not a lowercase, hyphenated slug" % sid, \
            "use only a-z, 0-9 and single hyphens, and rename the file to match"
    if sid and sid != stem:
        yield fm_line(spec, "id"), "frontmatter", "id %r doesn't equal the file name %r" % (sid, name), \
            "set id to %r or rename the file to %s.md" % (stem, sid)


@rule("frontmatter.status")
def check_status(spec):
    status = spec.fields.get("status", "")
    if status and status not in STATUSES:
        yield fm_line(spec, "status"), "frontmatter", "status %r is not one of %s" % (status, " | ".join(STATUSES)), \
            "set status to one of those"


@rule("frontmatter.dates")
def check_dates(spec):
    for key in DATE_FIELDS:
        value = spec.fields.get(key, "")
        if not value:
            continue
        ok = bool(DATE_RE.fullmatch(value))
        if ok:
            try:
                datetime.date(int(value[:4]), int(value[5:7]), int(value[8:]))
            except ValueError:
                ok = False
        if not ok:
            yield fm_line(spec, key), "frontmatter", "%s %r is not a real YYYY-MM-DD date" % (key, value), \
                "write %s as YYYY-MM-DD" % key


@rule("frontmatter.unaccepted")
def check_unaccepted(spec):
    for key in ("accepted_by", "accepted_on"):
        if spec.fields.get(key):
            yield fm_line(spec, key), "frontmatter", "%s is set but status is %r" % (key, spec.status), \
                "leave %s empty until the user accepts the spec" % key


@rule("frontmatter.accepted")
def check_accepted(spec):
    for key in ("accepted_by", "accepted_on"):
        if not spec.fields.get(key):
            yield fm_line(spec, key), "frontmatter", "%s is empty but status is %r" % (key, spec.status), \
                "only after the user's explicit yes, set %s; otherwise set status back to draft" % key


@rule("idea.sections")
def check_idea_sections(spec):
    for title in IDEA_SECTIONS:
        sec = spec.section(title)
        if sec is None:
            yield 1, title, "missing '## %s' heading" % title, "add the section from template-idea.md"
        elif not sec.text_lines():
            yield sec.line, title, "section is empty", "write the %s" % title.lower()


ABBREVIATIONS_RE = re.compile(r"\b(?:e\.g|i\.e|etc|vs|cf|approx)\.", re.I)


@rule("idea.goal-length")
def check_goal_length(spec):
    sec = spec.section("Goal")
    if not sec or not sec.text_lines():
        return
    text = " ".join(strip_code(ln.text) for ln in sec.text_lines())
    text = ABBREVIATIONS_RE.sub("", text)
    count = max(1, len(re.findall(r"[.!?]+(?=\s|$)", text)))
    if count > 3:
        yield sec.line, "Goal", "Goal has %d sentences; at most 3 are allowed" % count, \
            "cut the Goal to 1-3 sentences and move the rest to Context"


@rule("spec.sections")
def check_spec_sections(spec):
    found = [s.title for s in spec.sections]
    for s in spec.sections:
        if s.title not in SPEC_SECTIONS:
            yield s.line, s.title, "unexpected heading '## %s'" % s.title, \
                "use only the six template headings; move this content into the section it informs"
        elif spec.by_title[s.title] is not s:
            yield s.line, s.title, "'## %s' appears more than once" % s.title, "merge the two sections"
    for title in SPEC_SECTIONS:
        if title not in found:
            yield 1, title, "missing '## %s' heading" % title, "add the section from template-spec.md, in template order"
    present = [t for t in found if t in SPEC_SECTIONS]
    expected = [t for t in SPEC_SECTIONS if t in present]
    if len(set(present)) == len(present) and present != expected:
        first = next(i for i, (a, b) in enumerate(zip(present, expected)) if a != b)
        sec = spec.by_title[present[first]]
        yield sec.line, sec.title, "sections are out of order", "order the headings as in template-spec.md: " + ", ".join(SPEC_SECTIONS)


@rule("spec.filled")
def check_filled(spec):
    for title in SPEC_SECTIONS:
        sec = spec.section(title)
        if sec is not None and not sec.text_lines():
            yield sec.line, title, "section is empty", "fill in the %s section" % title


@rule("ac.only")
def check_ac_only(spec):
    sec, acs, tables, stray, malformed = spec.behavior()
    for ln in stray:
        yield ln.no, BEHAVIOR, "free prose about behavior, outside an AC", \
            "rewrite it as an AC ('- **AC-n:** Given ..., when ..., then ....') or move it to the section it belongs in"


@rule("ac.format")
def check_ac_format(spec):
    sec, acs, tables, stray, malformed = spec.behavior()
    for ln in malformed:
        yield ln.no, BEHAVIOR, "looks like an AC but isn't in the AC format", \
            "write it as '- **AC-n:** Given ..., when ..., then ....'"
    seen = {}
    for n, it in acs:
        if n in seen:
            yield it.line.no, BEHAVIOR, "AC-%d is used twice (first on line %d)" % (n, seen[n]), \
                "give the new AC the next unused ID; never reuse one"
        else:
            seen[n] = it.line.no
        text = " ".join([it.line.text] + [c.text for c in it.children
                                          if not CHILD_LABEL_RE.match(c.text)]).lower()
        missing = [w for w in ("given", "when", "then") if not re.search(r"\b%s\b" % w, text)]
        if missing:
            yield it.line.no, BEHAVIOR, "AC-%d has no %s" % (n, "/".join(missing)), \
                "write AC-%d as one Given/When/Then sentence" % n


def ac_checks(spec, allow_tbd):
    sec, acs, tables, stray, malformed = spec.behavior()
    for n, it in acs:
        verify = child_value(it, "verify")
        tbd = any(re.match(r"^\s+TBD[:.]", c.text) for c in it.children if not c.code)
        if verify and not verify[1]:
            yield verify[0].no, BEHAVIOR, "AC-%d has an empty verify: line" % n, \
                "name the exact command or test that checks AC-%d, in backticks" % n
        elif not verify and not (allow_tbd and tbd):
            what = "verify: line or TBD: line" if allow_tbd else "verify: line"
            fix = "add an indented 'verify: `<command>`' line under AC-%d" % n
            if allow_tbd:
                fix += ", or a 'TBD:' line saying what is unknown"
            yield it.line.no, BEHAVIOR, "AC-%d has no %s" % (n, what), fix


@rule("ac.verify-or-tbd")
def check_ac_verify_or_tbd(spec):
    return ac_checks(spec, allow_tbd=True)


@rule("ac.verify")
def check_ac_verify(spec):
    return ac_checks(spec, allow_tbd=False)


@rule("edge.table")
def check_edge_table(spec):
    sec, acs, tables, stray, malformed = spec.behavior()
    if sec is None:
        return
    if not tables:
        yield sec.line, BEHAVIOR, "no edge-case table", \
            "add the '| Input or condition | Expected behavior | AC |' table after the ACs"
    for table in tables:
        header = table_cells(table[0].text)
        if not header or header[-1] != "AC":
            yield table[0].no, BEHAVIOR, "table's last column isn't 'AC'", \
                "use the header '| Input or condition | Expected behavior | AC |'"
        if len(table) < 2 or not is_separator(table_cells(table[1].text)):
            yield table[0].no, BEHAVIOR, "table has no '|---|' separator row under its header", \
                "add '|---|---|---|' under the header"


@rule("edge.ac")
def check_edge_ac(spec):
    sec, acs, tables, stray, malformed = spec.behavior()
    ids = set(n for n, _ in acs)
    for table in tables:
        for ln in table[2:] if len(table) > 1 and is_separator(table_cells(table[1].text)) else table[1:]:
            cells = table_cells(ln.text)
            refs = [int(n) for n in AC_ID_RE.findall(cells[-1])] if cells else []
            if not refs:
                yield ln.no, BEHAVIOR, "edge-case row doesn't point to an AC", \
                    "put the ID of the AC that covers this row in the AC column, adding an AC if none does"
            for n in refs:
                if n not in ids:
                    yield ln.no, BEHAVIOR, "edge-case row points to AC-%d, which doesn't exist" % n, \
                        "point the row to an existing AC, or add AC-%d" % n


def labelled(spec, title):
    """Return {label: (label_line, [Item])} for the label lines in a section."""
    sec = spec.section(title)
    found, current = {}, None
    if sec is None:
        return sec, found
    labels = LABELS[title]
    chunk = []
    for ln in sec.lines + [Line(None, "", False)]:
        label = None
        if not ln.code and ln.no is not None:
            for lab in labels:
                if ln.text.rstrip() == lab + ":":
                    label = lab
        if label or ln.no is None:
            if current:
                found[current] = (found[current][0], items(chunk)[0])
            if label:
                current, chunk = label, []
                found.setdefault(label, (ln.no, []))
            continue
        if current:
            chunk.append(ln)
    return sec, found


@rule("guard.labels")
def check_guard_labels(spec):
    for title, labels in GUARD_LABELS.items():
        sec, found = labelled(spec, title)
        if sec is None:
            continue
        for lab in labels:
            if lab not in found:
                yield sec.line, title, "no '%s:' list" % lab, \
                    "add a '%s:' line followed by its list, as in guardrails.md" % lab


@rule("guard.items")
def check_guard_items(spec):
    for title in (GOAL, BOUNDARIES):
        sec, found = labelled(spec, title)
        for lab in LIST_LABELS:
            if lab in found and not found[lab][1]:
                yield found[lab][0], title, "the '%s:' list has no items" % lab, \
                    "add at least one item under '%s:'" % lab


@rule("guard.decisions")
def check_guard_decisions(spec):
    sec, found = labelled(spec, BOUNDARIES)
    if "Decision Log" not in found:
        return
    line, entries = found["Decision Log"]
    if not entries:
        yield line, BOUNDARIES, "the Decision Log has no entries", \
            "add at least one '- **D-n:** <decision>.' entry from the interview or the repo"
    for it in entries:
        m = D_RE.match(it.line.text)
        if not m:
            yield it.line.no, BOUNDARIES, "Decision Log entry isn't in the '- **D-n:** <decision>.' format", \
                "write it as '- **D-n:** <decision>.' with why:, rejected: and source: lines"
            continue
        for key in DECISION_LINES:
            value = child_value(it, key)
            if not value or not value[1]:
                yield it.line.no, BOUNDARIES, "D-%s has no %s: line" % (m.group(1), key), \
                    "add an indented '%s:' line under D-%s" % (key, m.group(1))


def code_spans(text):
    return [m.group(2).strip() for m in INLINE_CODE_RE.finditer(text)]


def item_text(it):
    return " ".join([it.line.text] + [c.text for c in it.children if not c.code])


def table_rows(table):
    """The body rows of a table, after its header and separator."""
    if len(table) > 1 and is_separator(table_cells(table[1].text)):
        return table[2:]
    return table[1:]


def only_tbd(sec):
    """True if a section holds nothing but TBD lines, as a draft may."""
    lines = sec.text_lines()
    return bool(lines) and all(re.match(r"^(?:- )?TBD\b", ln.text.strip()) for ln in lines)


def env_commands(spec):
    """(line, command) for every command Environment & Commands names.

    A command is an inline code span on a text line, or a line inside a fence.
    """
    sec = spec.section(ENV)
    found = []
    if sec is None:
        return found
    for ln in sec.lines:
        if ln.code:
            if not FENCE_RE.match(ln.text) and ln.text.strip():
                found.append((ln, ln.text.strip()))
        else:
            found.extend((ln, s) for s in code_spans(ln.text))
    return found


def tokens(cmd):
    try:
        return shlex.split(cmd)
    except ValueError:
        return cmd.split()


def ac_check_lines(it):
    """(verify, has_tbd) for an AC item: its verify: (line, value) and whether it has a TBD: line."""
    verify = child_value(it, "verify")
    tbd = any(re.match(r"^\s+TBD[:.]", c.text) for c in it.children if not c.code)
    return verify, tbd


@rule("ac.example")
def check_ac_example(spec):
    sec, acs, tables, stray, malformed = spec.behavior()
    for n, it in acs:
        for ln in it.children:
            m = re.match(r"^\s+example:\s*(.*)$", ln.text)
            if ln.code or not m:
                continue
            value = m.group(1).strip()
            masked = INLINE_CODE_RE.sub(lambda c: "x" * len(c.group(0)), value)
            arrow = re.search(r"→|->", masked)
            if not arrow or not code_spans(value[:arrow.start()]) or not value[arrow.end():].strip():
                yield ln.no, BEHAVIOR, "AC-%d's example: line isn't '`<input>` → <expected output>'" % n, \
                    "write it as 'example: `<exact input or command>` → <expected result, with literal output in backticks>'"


@rule("edge.categories")
def check_edge_categories(spec):
    sec, acs, tables, stray, malformed = spec.behavior()
    if sec is None or not tables:
        return
    covered = set()
    for table in tables:
        for ln in table_rows(table):
            cells = table_cells(ln.text)
            first = cells[0].lower() if cells else ""
            covered.update(c for c in EDGE_CATEGORIES if first.startswith(c.lower()))
    for ln in sec.text_lines():
        if ln.text.startswith("Not applicable:"):
            covered.update(c for c in EDGE_CATEGORIES if c.lower() in ln.text.lower())
    missing = [c for c in EDGE_CATEGORIES if c not in covered]
    if missing:
        yield tables[0][0].no, BEHAVIOR, "the edge-case table doesn't cover %s" % ", ".join(c.lower() for c in missing), \
            "add a row starting '%s:', or say why it can't happen in a 'Not applicable: <category> (<reason>).' line under the table" % missing[0]


@rule("nongoal.path")
def check_nongoal_path(spec):
    sec, found = labelled(spec, GOAL)
    if "Non-goals" not in found or not found["Non-goals"][1]:
        return
    line, entries = found["Non-goals"]
    for it in entries:
        if any(PATHLIKE_RE.search(s) for s in code_spans(item_text(it))):
            return
    yield line, GOAL, "no non-goal names adjacent code by path", \
        "name the adjacent code an agent might be tempted to change, by path: 'Changing `src/<module>`'"


@rule("contract.labels")
def check_contract_labels(spec):
    sec, found = labelled(spec, INTERFACES)
    if sec is None or only_tbd(sec):
        return
    for lab in CONTRACT_LABELS:
        if lab not in found:
            yield sec.line, INTERFACES, "no '%s:' list" % lab, \
                "add the '%s:' label followed by its list, as in template-spec.md" % lab


@rule("contract.format")
def check_contract_format(spec):
    sec, found = labelled(spec, INTERFACES)
    for lab in CONTRACT_LABELS:
        for it in found.get(lab, (None, []))[1]:
            if re.match(r"^- TBD\b", it.line.text):
                continue
            if lab == "Existing" and not EXISTING_RE.match(it.line.text):
                yield it.line.no, INTERFACES, "Existing: item doesn't start with a `path`", \
                    "start it with the repo-relative path in backticks, then its symbols: '- `src/types.ts` (`Todo`): why it matters'"
            if lab == "New" and not code_spans(item_text(it)) and not any(c.code for c in it.children):
                yield it.line.no, INTERFACES, "New: item states no contract in code", \
                    "give the signature, type, schema or CLI usage in backticks or a fenced block, in terms of the existing types"


@rule("contract.items")
def check_contract_items(spec):
    sec, found = labelled(spec, INTERFACES)
    if sec is None or any(lab not in found for lab in CONTRACT_LABELS):
        return
    if not found["Existing"][1] and not found["New"][1]:
        yield found["Existing"][0], INTERFACES, "Existing: and New: have no items", \
            "link the existing files and types the goal builds on, and state the new contracts"


@rule("gate.matches-acs")
def check_gate_matches_acs(spec):
    _, acs, _, _, malformed = spec.behavior()
    sec, found = labelled(spec, GATE)
    ids = [n for n, _ in acs]
    if sec is None or not acs or only_tbd(sec) or malformed or len(set(ids)) != len(ids):
        return  # nothing to compare yet, or ac.format reports the ACs first
    if GATE_PER_AC not in found:
        yield sec.line, GATE, "no '%s:' list" % GATE_PER_AC, \
            "add it, with one '- AC-n: `<verify command>`' entry per AC, as acceptance-criteria.md says"
        return
    line, entries = found[GATE_PER_AC]
    by_id = {}
    for n, it in acs:
        by_id.setdefault(n, it)
    seen, order = set(), []
    for it in entries:
        m = GATE_ENTRY_RE.match(it.line.text)
        if not m:
            yield it.line.no, GATE, "gate entry isn't '- AC-n: <verify command>'", \
                "write it as '- AC-n: `<the AC's verify command>`'"
            continue
        n, value = int(m.group(1)), m.group(2).strip()
        if n in seen:
            yield it.line.no, GATE, "AC-%d is listed twice" % n, "keep one entry per AC"
            continue
        seen.add(n)
        order.append(n)
        if n not in by_id:
            yield it.line.no, GATE, "the gate lists AC-%d, which doesn't exist" % n, \
                "remove the entry, or add AC-%d to Behavior & Edge Cases" % n
            continue
        verify, tbd = ac_check_lines(by_id[n])
        if verify and verify[1]:
            if value != verify[1]:
                yield it.line.no, GATE, "AC-%d's gate entry doesn't match its verify: line" % n, \
                    "copy the command exactly from AC-%d's verify: line, %s" % (n, verify[1])
        elif tbd and not TBD_RE.match(value):
            yield it.line.no, GATE, "AC-%d has a TBD: line but its gate entry isn't a TBD" % n, \
                "copy AC-%d's TBD: line into its gate entry" % n
    for n in sorted(by_id):
        if n not in seen:
            yield line, GATE, "AC-%d is missing from the gate" % n, \
                "add '- AC-%d: <its verify command>' in ID order" % n
    if order != sorted(order):
        yield line, GATE, "gate entries aren't in AC ID order", "list them as AC-1, AC-2, and so on"


@rule("gate.suite")
def check_gate_suite(spec):
    sec, found = labelled(spec, GATE)
    commands = set(cmd for _, cmd in env_commands(spec))
    if sec is None or not commands or only_tbd(sec):
        return
    if GATE_SUITE not in found:
        yield sec.line, GATE, "no '%s:' list" % GATE_SUITE, \
            "add it, listing the lint, typecheck, test and build commands from Environment & Commands"
        return
    line, entries = found[GATE_SUITE]
    if not entries:
        yield line, GATE, "the whole-suite list has no items", \
            "list the whole-suite commands from Environment & Commands, without setup steps"
    for it in entries:
        if re.match(r"^- TBD\b", it.line.text):
            continue
        spans = code_spans(it.line.text)
        if not spans:
            yield it.line.no, GATE, "whole-suite entry has no command in backticks", \
                "write it as '- `<command from Environment & Commands>`'"
        for s in spans:
            if s not in commands:
                yield it.line.no, GATE, "`%s` isn't a command in Environment & Commands" % s, \
                    "copy the command exactly from Environment & Commands, or add it there first"


def runner_prefix(cmd):
    """A command's runner: its first word, plus a subcommand word (`npm test`, `go test`)."""
    tk = tokens(cmd)
    while tk and re.match(r"^[A-Z_][A-Z0-9_]*=", tk[0]):
        tk = tk[1:]
    if len(tk) > 1 and re.match(r"^[a-z][\w:-]*$", tk[1]):
        return tk[:2]
    return tk[:1]


@rule("verify.runner")
def check_verify_runner(spec):
    prefixes = [p for p in (runner_prefix(cmd) for _, cmd in env_commands(spec)) if p]
    if not prefixes:
        return
    _, acs, _, _, _ = spec.behavior()
    for n, it in acs:
        verify, _ = ac_check_lines(it)
        spans = code_spans(verify[1]) if verify else []
        if not spans:
            continue
        tk = tokens(spans[0])
        while tk and re.match(r"^[A-Z_][A-Z0-9_]*=", tk[0]):
            tk = tk[1:]
        if not any(tk[:len(p)] == p for p in prefixes):
            yield verify[0].no, BEHAVIOR, "AC-%d's verify: command doesn't start with a runner from Environment & Commands" % n, \
                "use the runner and filter syntax that Environment & Commands lists, or add the runner there"


def body_lines(spec):
    for sec, ln in spec.all_lines():
        if not ln.code:
            yield sec, ln


def section_name(sec):
    return sec.title if sec else "(before the first heading)"


@rule("no-tbd")
def check_no_tbd(spec):
    for sec, ln in body_lines(spec):
        if TBD_RE.search(strip_code(ln.text)):
            yield ln.no, section_name(sec), "TBD left in the spec", \
                "resolve it with the user, or keep the spec at draft"


@rule("no-open-questions")
def check_no_open_questions(spec):
    for sec, ln in body_lines(spec):
        text = strip_code(ln.text)
        h = ANY_HEADING_RE.match(text)
        if h and h.group(1).strip().lower() == "open questions" or text.strip().lower() == "open questions:":
            yield ln.no, section_name(sec), "an Open Questions list is left in the spec", \
                "resolve each question into the section it affects, then remove the list"
        elif QUESTION_RE.search(text) and not TBD_RE.search(text):
            yield ln.no, section_name(sec), "open question left in the spec", \
                "answer it with the user and write the answer into the spec, or keep the spec at draft"


def count_words(sec):
    n = 0
    for ln in sec.lines:
        text = ln.text
        if FENCE_RE.match(text):
            continue
        if text.lstrip().startswith("|"):
            cells = table_cells(text)
            if is_separator(cells):
                continue
            text = " ".join(cells)
        n += len(text.split())
    return n


@rule("budget")
def check_budget(spec):
    for sec in spec.sections:
        budget = WORD_BUDGETS.get(sec.title)
        if budget is None or spec.by_title[sec.title] is not sec:
            continue
        words = count_words(sec)
        if words > budget:
            yield sec.line, sec.title, "%d words, over the %d-word budget" % (words, budget), \
                "cut %d words: link to files instead of describing them, and drop prose that types and tests cover" % (words - budget)


# ---------------------------------------------------------------------------
# Rules that need the target repo (--repo ROOT). spec.repo is its real path.
# ---------------------------------------------------------------------------

def existing_items(spec):
    """(line, path, [symbol]) for each Existing: item in Interfaces & Data Contracts."""
    sec, found = labelled(spec, INTERFACES)
    result = []
    for it in found.get("Existing", (None, []))[1]:
        m = EXISTING_RE.match(it.line.text)
        if m:
            path = re.sub(r":\d+(?:-\d+)?$", "", m.group(1).strip())
            symbols = [re.sub(r"\(.*$", "", s).strip() for s in code_spans(m.group(2) or "")]
            result.append((it.line, path, [s for s in symbols if s]))
    return result


def repo_path(spec, path):
    """The file at a repo-relative path, or None if the path leaves the repo."""
    if os.path.isabs(path) or ".." in path.split("/"):
        return None
    return os.path.join(spec.repo, path)


@rule("repo.paths")
def check_repo_paths(spec):
    for ln, path, symbols in existing_items(spec):
        full = repo_path(spec, path)
        if full is None or not os.path.exists(full):
            yield ln.no, INTERFACES, "`%s` doesn't exist in the repo" % path, \
                "link the real repo-relative path, or move the item to New: if the build creates it"
            continue
        if os.path.isdir(full) or not symbols:
            continue
        try:
            with open(full, encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        for s in symbols:
            name = re.split(r"[.#:]", s)[-1]
            if not re.search(r"(?<![\w$])%s(?![\w$])" % re.escape(name), text):
                yield ln.no, INTERFACES, "`%s` doesn't contain `%s`" % (path, s), \
                    "link the file that defines `%s`, or correct the symbol's name" % s


PM_BUILTINS = {
    "add", "audit", "bin", "cache", "ci", "config", "create", "dedupe", "dlx", "exec", "i", "info",
    "init", "install", "link", "list", "ls", "outdated", "pack", "prune", "publish", "rebuild",
    "remove", "rm", "store", "unlink", "up", "update", "upgrade", "version", "why", "workspace",
    "workspaces", "x",
}


def named_target(cmd):
    """(kind, name) for a command that names a package script, make target or just recipe."""
    tk = tokens(cmd)
    while tk and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tk[0]):
        tk = tk[1:]
    if len(tk) < 2 or tk[1].startswith("-"):
        return None
    tool, first = tk[0], tk[1]
    if tool == "npm":
        if first in ("run", "run-script"):
            return ("script", tk[2]) if len(tk) > 2 and not tk[2].startswith("-") else None
        if first in ("test", "t", "start", "stop", "restart"):
            return ("script", "test" if first == "t" else first)
        return None
    if tool in ("yarn", "pnpm"):
        if first == "run":
            return ("script", tk[2]) if len(tk) > 2 and not tk[2].startswith("-") else None
        return None if first in PM_BUILTINS else ("script", first)
    if tool == "bun":
        if first == "run" and len(tk) > 2 and not PATHLIKE_RE.search(tk[2]):
            return ("script", tk[2])
        return None
    if tool == "make" and "=" not in first:
        return ("make", first)
    if tool == "just":
        return ("just", first)
    return None


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def repo_targets(root):
    """{kind: (file name, set of names) or None} for the repo's scripts, make targets and recipes."""
    found = {"script": None, "make": None, "just": None}
    text = read_text(os.path.join(root, "package.json"))
    if text is not None:
        try:
            scripts = json.loads(text).get("scripts") or {}
            found["script"] = ("package.json", set(scripts))
        except (ValueError, AttributeError):
            found["script"] = ("package.json", set())
    for name in ("GNUmakefile", "makefile", "Makefile"):
        text = read_text(os.path.join(root, name))
        if text is not None:
            names = set()
            for m in re.finditer(r"^([^\s:=#][^:=#]*?)\s*::?(?!=)", text, re.M):
                names.update(m.group(1).split())
            found["make"] = (name, names)
    for name in (".justfile", "Justfile", "justfile"):
        text = read_text(os.path.join(root, name))
        if text is not None:
            names = set(re.findall(r"^@?([A-Za-z0-9_-]+)(?:\s[^:\n]*)?:(?!=)", text, re.M))
            names.update(re.findall(r"^alias\s+([A-Za-z0-9_-]+)\s*:=", text, re.M))
            found["just"] = (name, names)
    return found


def named_commands(spec):
    """(line, section, command) for every command the spec names."""
    for ln, cmd in env_commands(spec):
        yield ln, ENV, cmd
    _, acs, _, _, _ = spec.behavior()
    for n, it in acs:
        verify, _ = ac_check_lines(it)
        if verify:
            for s in code_spans(verify[1]):
                yield verify[0], BEHAVIOR, s
    sec = spec.section(GATE)
    for ln in sec.text_lines() if sec else []:
        for s in code_spans(ln.text):
            yield ln, GATE, s


KIND_NAMES = {"script": ("script", "a package.json"), "make": ("target", "a Makefile"), "just": ("recipe", "a justfile")}


@rule("repo.commands")
def check_repo_commands(spec):
    targets = repo_targets(spec.repo)
    reported = set()
    for ln, section, cmd in named_commands(spec):
        named = named_target(cmd)
        if named is None or named in reported:
            continue
        kind, name = named
        noun, missing_file = KIND_NAMES[kind]
        have = targets[kind]
        if have is not None and (name in have[1] or (kind == "make" and "%" in have[1])):
            continue
        reported.add(named)
        where = "no %s '%s' in %s" % (noun, name, have[0]) if have else "the repo has no %s" % missing_file[2:]
        yield ln.no, section, "`%s` names %s" % (cmd, where), \
            "copy the command from package.json, the Makefile, the justfile or CI, as repo-scan.md says"


def git(root, *args):
    try:
        result = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def linked_files(spec):
    """Repo-relative paths of the existing files and directories the spec links to."""
    candidates = [path for _, path, _ in existing_items(spec)]
    sec = spec.section(INTERFACES)
    for ln in sec.text_lines() if sec else []:
        candidates.extend(code_spans(ln.text))
    _, acs, _, _, _ = spec.behavior()
    for n, it in acs:
        verify, _ = ac_check_lines(it)
        for s in code_spans(verify[1]) if verify else []:
            candidates.extend(tokens(s))
    found = set()
    for c in candidates:
        c = re.sub(r":\d+(?:-\d+)?$", "", c.strip())
        full = repo_path(spec, c) if c and PATHLIKE_RE.search(c) else None
        if full and os.path.exists(full):
            found.add(c.rstrip("/"))
    return sorted(found)


@rule("repo.stale")
def check_repo_stale(spec):
    spec_path = os.path.realpath(spec.path)
    if git(spec.repo, "status", "--porcelain", "--", spec_path) != "":
        return  # not a git repo, git missing, or the spec has uncommitted changes
    last = git(spec.repo, "log", "-1", "--format=%H", "--", spec_path)
    paths = linked_files(spec)
    if not last or not paths:
        return
    commits = git(spec.repo, "rev-list", last + "..HEAD", "--", *paths)
    if not commits:
        return
    touched = git(spec.repo, "diff", "--name-only", last, "HEAD", "--", *paths) or ""
    count = len(commits.split())
    yield fm_line(spec, "updated"), "frontmatter", \
        "%d commit%s since the spec last changed touch%s %s" % (
            count, "" if count == 1 else "s", "es" if count == 1 else "",
            ", ".join(touched.split()) or ", ".join(paths)), \
        "sync the spec with update mode ('sync the spec') and commit it with the code"


assert set(RULES) == set(RULE_TEXT), "every rule needs RULE_TEXT and a function"


