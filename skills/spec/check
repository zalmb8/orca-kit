def check_spec(spec, as_status=None, repo=None):
    """Return (status_checked, [Problem]). With repo, also run that status's --repo rules."""
    problems = []
    claimed = spec.status
    status = as_status or claimed
    rule_ids = list(STATUS_RULES.get(status, FRONTMATTER_RULES))
    if as_status and as_status != claimed:
        rule_ids = [r for r in rule_ids if r not in ACCEPTANCE_RECORD_RULES]
    if status not in STATUS_RULES and "frontmatter.status" not in rule_ids:
        rule_ids.append("frontmatter.status")
    if repo:
        spec.repo = os.path.realpath(repo)
        rule_ids += REPO_RULES.get(status, [])
    for rule_id in rule_ids:
        for line, section, message, fix in RULES[rule_id](spec):
            problems.append(Problem(severity(rule_id, status), line, section, rule_id, message, fix))
    problems.sort(key=lambda p: (p.line, p.rule))
    return status, problems


def format_problem(path, p):
    fix = p.fix[0].upper() + p.fix[1:]
    return "%s:%d: %s [%s] %s: %s. Fix: %s." % (path, p.line, p.severity, p.rule, p.section, p.message, fix)


def section_text(spec, title):
    """The `## title` heading and its lines, without trailing blank lines, or None."""
    sec = spec.section(title)
    if sec is None:
        return None
    lines = ["## " + sec.title] + [ln.text for ln in sec.lines]
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines) + "\n"


USAGE = ("usage: check [--as idea|draft|accepted] [--repo ROOT] <spec.md> [<spec.md> ...]\n"
         "       check --section HEADING <spec.md>\n"
         "       check --rules")


def print_rules():
    for status in STATUSES:
        print("%s:" % status)
        for rule_id in STATUS_RULES[status]:
            print("  %-24s %-7s %s" % (rule_id, severity(rule_id, status), RULE_TEXT[rule_id]))
        for rule_id in REPO_RULES[status]:
            print("  %-24s %-7s %s" % (rule_id, severity(rule_id, status), RULE_TEXT[rule_id]))


def option_value(argv, i, name):
    """The value of `--name VALUE` or `--name=VALUE` at argv[i], and the next index."""
    arg = argv[i]
    if arg == name:
        if i + 1 >= len(argv):
            raise UsageError("%s needs a value" % name)
        return argv[i + 1], i + 2
    return arg[len(name) + 1:], i + 1


def parse_args(argv):
    opts = {"mode": "check", "as": None, "repo": None, "section": None, "paths": []}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            opts["mode"] = "help"
            return opts
        if arg == "--rules":
            opts["mode"] = "rules"
            return opts
        name = arg.split("=", 1)[0]
        if name in ("--as", "--repo", "--section"):
            value, i = option_value(argv, i, name)
            opts[name[2:]] = value
            continue
        if arg == "--":
            opts["paths"].extend(argv[i + 1:])
            break
        if arg.startswith("-") and arg != "-":
            raise UsageError("unknown option %r" % arg)
        opts["paths"].append(arg)
        i += 1
    if opts["as"] is not None and opts["as"] not in ("idea", "draft", "accepted"):
        raise UsageError("--as must be idea, draft or accepted, not %r" % opts["as"])
    if opts["repo"] is not None and not os.path.isdir(opts["repo"]):
        raise UsageError("--repo %r is not a directory" % opts["repo"])
    if not opts["paths"]:
        raise UsageError("no spec files given")
    if opts["section"] is not None:
        if opts["as"] or opts["repo"]:
            raise UsageError("--section can't be combined with --as or --repo")
        if len(opts["paths"]) != 1:
            raise UsageError("--section takes exactly one spec file")
        opts["mode"] = "section"
    return opts


def load(path):
    """Return (Spec, None), or (None, the error line to print)."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        return None, "%s:1: error [usage] file: can't read the file (%s). Fix: Pass the path to a spec .md file." % (path, e)
    try:
        return Spec(path, text), None
    except ParseError as e:
        return None, "%s:%d: error [parse] %s: %s. Fix: Correct the file so it parses." % (path, e.line, e.where, e.message)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts = parse_args(argv)
    except UsageError as e:
        sys.stderr.write("check: %s\n%s\n" % (e, USAGE))
        return 2
    if opts["mode"] == "help":
        sys.stdout.write(__doc__.lstrip())
        return 0
    if opts["mode"] == "rules":
        print_rules()
        return 0
    if opts["mode"] == "section":
        path = opts["paths"][0]
        spec, error = load(path)
        if error:
            print(error)
            return 2
        text = section_text(spec, opts["section"])
        if text is None:
            found = ", ".join(s.title for s in spec.sections)
            sys.stderr.write("check: %s has no '## %s' section; it has: %s\n" % (path, opts["section"], found))
            return 2
        sys.stdout.write(text)
        return 0
    worst = 0
    as_status = opts["as"]
    for path in opts["paths"]:
        spec, error = load(path)
        if error:
            print(error)
            worst = 2
            continue
        status, problems = check_spec(spec, as_status, opts["repo"])
        for p in problems:
            print(format_problem(path, p))
        errors = sum(1 for p in problems if p.severity == "error")
        warnings = len(problems) - errors
        if errors:
            worst = max(worst, 1)
        else:
            label = status if not as_status or as_status == spec.status else "%s, checked as %s" % (spec.status, status)
            print("%s: ok (%s)%s" % (path, label, ", %d warning%s" % (warnings, "" if warnings == 1 else "s") if warnings else ""))
    return worst


if __name__ == "__main__":
    sys.exit(main())
