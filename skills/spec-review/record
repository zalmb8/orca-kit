#!/usr/bin/env python3
"""Validate orca-kit:spec-review review records (specs/reviews/<slug>.json).

Usage:
  record <specs/reviews/<slug>.json> [...]
  record --rules

  --rules       List the rules each record is checked against, and exit.

A review record is a JSON object, committed next to the spec it reviews
(docs/spec-review/ROADMAP.md, "Findings format"; the format is in
risk.md next to this script):

  {
    "spec": "<slug>",
    "risk": {"tier": "low" | "high", "risks": [<risk>, ...], "reasons": [<text>, ...]},
    "sign_off": null | {"signed_off_by": <name>, "signed_off_on": "YYYY-MM-DD", "risks": [<risk>, ...]},
    "passes": [{"findings": [<finding>, ...], "open_blockers": <n>,
                "words": <n>, "gates": "passed" | "failed"}, ...],
    "questions": [{"id": "pass-<n>.<finding id> | pass-<n>.skim | pass-<n>.loop",
                   "pass": <n>, "trigger": "decision" | "skim" | "loop",
                   "finding": <finding id> | null, "question": <text>,
                   "options": [{"key": <key>, "text": <text>}, ...],
                   "answer": null | {"choice": <key>, "words": <the user's reply>,
                                     "answered_on": "YYYY-MM-DD"}}, ...]
  }

spec, risk and sign_off are required; only `sign_off` may be null. `passes`
(v0.4) is optional, so a v0.3 record stays valid: one entry per review pass,
at most 3, each holding that pass's findings (each valid under the findings
validator, ids unique, no two with the same rule, location and risk, as
`findings --merge` leaves them) and its count of open blockers, and
optionally (v0.5, the revision loop) the spec's word count and its gate
result for that pass. The open count is open_counts below, the one rule
converge and summary use too (v0.8): a pass's blockers, less a
slicer.oversized blocker the user answered `keep` to in an earlier pass.
Every risk a finding in any pass names must be in risk.risks: a risk a pass
raised stays raised for the rest of the review (v0.8).
`questions` (v0.6, the human-in-the-loop pauses; pauses.md) is optional too,
and needs `passes`: one entry per question `pause` printed and the skill
asked, with the options shown and, once the user replies, their answer. A
`decision` question names a decision blocker of its pass, a `skim` question
the slicer's `slicer.oversized` blocker or nothing (the length ceiling), a
`loop` question nothing; each trigger has its fixed option keys, and the
answer's choice is one of them. Unknown fields are rejected.

Prints one line per problem:
  <file>:<line>: error [<rule>] <field>: <problem>. Fix: <what to do>.
then one summary line per file:
  <file>: ok, risk high (migration), signed off by <name> on <date>
  <file>: ok, risk low, no sign-off
  <file>: ok, risk low, no sign-off, 1 pass: 3 findings: 1 blocker (0 decision), 2 nit
  <file>: ok, risk low, no sign-off, 1 pass: 3 findings: ..., 1 question (1 answered)
  <file>: <n> problem(s)

This script only reads records. It never writes one, and never fills in a
sign-off or an answer: only the user's own reply does that.

Exit codes: 0 every record is valid, 1 a record breaks a rule, 2 a usage
error or a file that isn't a JSON object.

Python 3 standard library only; no install step.
"""

import datetime
import importlib.machinery
import importlib.util
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def load_sibling(name):
    loader = importlib.machinery.SourceFileLoader("spec_review_" + name, os.path.join(HERE, name))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


FINDINGS = load_sibling("findings")

RISKS = ("auth", "security-boundary", "data-model", "migration", "billing", "public-api", "breaking-change")
TIERS = ("low", "high")
FIELDS = ("spec", "risk", "sign_off")
OPTIONAL_FIELDS = ("passes", "questions")
PASS_FIELDS = ("findings", "open_blockers")
OPTIONAL_PASS_FIELDS = ("words", "gates")
GATE_RESULTS = ("passed", "failed")
MAX_PASSES = 3
RISK_FIELDS = ("tier", "risks", "reasons")
SIGN_OFF_FIELDS = ("signed_off_by", "signed_off_on", "risks")
QUESTION_FIELDS = ("id", "pass", "trigger", "finding", "question", "options", "answer")
ANSWER_FIELDS = ("choice", "words", "answered_on")
TRIGGERS = ("skim", "decision", "loop")
# The option keys each trigger may show, in order (pauses.md). `pause` prints them.
OPTION_KEYS = {
    "decision": tuple(tuple("abcde"[:k]) + ("other", "open") for k in range(2, 6)) + (("other", "open"),),
    "skim": (("split", "keep"), ("split", "trim")),
    "loop": (("finish", "refine"),),
}
# Choices that answer the question and let the loop go on; every other choice ends the review.
# A decision's lettered options (a, b, ...) are the reviewer's alternatives, as pause splits them.
RESOLVING = ("a", "b", "c", "d", "e", "other", "keep")
SKIM_RULE = "slicer.oversized"

SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

RULE_TEXT = {
    "record.fields": "the record has exactly " + ", ".join(FIELDS) + ", and optionally " + ", ".join(OPTIONAL_FIELDS),
    "record.spec": "spec is the slug the file is named after (<slug>.json)",
    "record.risk": "risk has tier (low | high), risks (unique, from the risk list; empty exactly when tier is low) and reasons (text; non-empty when tier is high)",
    "record.sign-off": "sign_off is null, or has signed_off_by (a name), signed_off_on (a real YYYY-MM-DD date) and risks (the non-empty, unique risks shown to the person signing)",
    "record.passes": "passes, if present, is a list of 1 to %d passes, each with findings (valid findings, unique ids, "
                     "no duplicate rule, location and risk) and open_blockers (its open blockers: its blockers, less a "
                     "slicer.oversized the user answered keep to in an earlier pass, as converge and summary count them), and optionally "
                     "words (the spec's word count) and gates (passed | failed); "
                     "the risks every pass's findings name are in risk.risks (a raised risk stays raised for the review)" % MAX_PASSES,
    "record.questions": "questions, if present, needs passes and is a list of questions, each with exactly "
                        + ", ".join(QUESTION_FIELDS) + ": a unique id pass-<n>.<finding id> | pass-<n>.skim | pass-<n>.loop "
                        "matching its pass, trigger and finding; a decision question names a decision blocker of its pass, "
                        "a skim question the slicer.oversized blocker or null, a loop question null; options are the trigger's "
                        "fixed keys with text; answer is null or the choice (one of the keys), the user's words and the date",
}

USAGE = ("usage: record <specs/reviews/<slug>.json> [...]\n"
         "       record --rules")


class UsageError(Exception):
    pass


def show(value, limit=40):
    text = json.dumps(value, ensure_ascii=False)
    return text if len(text) <= limit else text[:limit - 3] + "..."


def is_text(value):
    return isinstance(value, str) and value.strip() != ""


def line_of(text, name):
    m = re.compile(r'"%s"\s*:' % re.escape(name)).search(text)
    return text.count("\n", 0, m.start()) + 1 if m else 1


def risk_list_problem(value, allow_empty):
    """A problem text for a list of risks, or None."""
    if not isinstance(value, list):
        return "is %s, not a list" % show(value)
    bad = [v for v in value if v not in RISKS]
    if bad:
        return "has %s, not one of %s" % (show(bad[0]), ", ".join(RISKS))
    if len(set(value)) != len(value):
        return "lists a risk twice"
    if not value and not allow_empty:
        return "is empty"
    return None


def check_record(data, text, stem):
    """[(line, rule, field, problem, fix)] for one parsed record."""
    out = []

    def bad(name, rule, field, problem, fix):
        out.append((line_of(text, name), rule, field, problem, fix))

    missing = [f for f in FIELDS if f not in data]
    extra = sorted(f for f in data if f not in FIELDS + OPTIONAL_FIELDS)
    if missing:
        out.append((1, "record.fields", "record", "missing " + ", ".join(missing),
                    "add %s; sign_off is null until the user signs off" % ", ".join(missing)))
    if extra:
        bad(extra[0], "record.fields", "record", "unknown field%s %s" % ("s" if len(extra) > 1 else "", ", ".join(extra)),
            "remove it; this release's record has only " + ", ".join(FIELDS + OPTIONAL_FIELDS))

    if "spec" in data:
        spec = data["spec"]
        if not (isinstance(spec, str) and SLUG_RE.match(spec)):
            bad("spec", "record.spec", "spec", "spec is %s, not a slug" % show(spec), "give the spec's slug, such as \"add-due-dates\"")
        elif spec != stem:
            bad("spec", "record.spec", "spec", "spec %s doesn't match the file name %s.json" % (show(spec), stem),
                "name the file specs/reviews/<slug>.json after the spec it reviews")

    if "risk" in data:
        risk = data["risk"]
        if not isinstance(risk, dict):
            bad("risk", "record.risk", "risk", "risk is %s, not an object" % show(risk),
                "give {\"tier\": ..., \"risks\": [...], \"reasons\": [...]} from `gate --risk`")
        else:
            missing = [f for f in RISK_FIELDS if f not in risk]
            extra = sorted(f for f in risk if f not in RISK_FIELDS)
            if missing:
                bad("risk", "record.risk", "risk", "risk is missing " + ", ".join(missing), "add tier, risks and reasons")
            if extra:
                bad(extra[0], "record.risk", "risk", "risk has unknown field%s %s" % ("s" if len(extra) > 1 else "", ", ".join(extra)),
                    "keep only tier, risks and reasons")
            if "tier" in risk and risk["tier"] not in TIERS:
                bad("tier", "record.risk", "risk.tier", "tier is %s, not low or high" % show(risk["tier"]), "use low or high")
            if "risks" in risk:
                problem = risk_list_problem(risk["risks"], True)
                if problem:
                    bad("risks", "record.risk", "risk.risks", "risks " + problem, "list each risk `gate --risk` reported, once")
                elif risk.get("tier") in TIERS and (risk["tier"] == "high") != bool(risk["risks"]):
                    bad("tier", "record.risk", "risk.tier", "tier is %s but risks is %s" % (show(risk["tier"]), show(risk["risks"])),
                        "use tier high exactly when risks is non-empty")
            if "reasons" in risk:
                reasons = risk["reasons"]
                if not (isinstance(reasons, list) and all(is_text(r) for r in reasons)):
                    bad("reasons", "record.risk", "risk.reasons", "reasons is %s, not a list of text" % show(reasons),
                        "list the reason lines `gate --risk` printed")
                elif risk.get("tier") == "high" and not reasons:
                    bad("reasons", "record.risk", "risk.reasons", "reasons is empty for a high-risk spec",
                        "list the reason lines `gate --risk` printed")

    if "sign_off" in data and data["sign_off"] is not None:
        so = data["sign_off"]
        if not isinstance(so, dict):
            bad("sign_off", "record.sign-off", "sign_off", "sign_off is %s, not null or an object" % show(so),
                "use null until the user signs off")
        else:
            missing = [f for f in SIGN_OFF_FIELDS if f not in so]
            extra = sorted(f for f in so if f not in SIGN_OFF_FIELDS)
            if missing:
                bad("sign_off", "record.sign-off", "sign_off", "sign_off is missing " + ", ".join(missing),
                    "record signed_off_by, signed_off_on and risks, from the user's explicit yes only")
            if extra:
                bad(extra[0], "record.sign-off", "sign_off", "sign_off has unknown field%s %s" % ("s" if len(extra) > 1 else "", ", ".join(extra)),
                    "keep only signed_off_by, signed_off_on and risks")
            if "signed_off_by" in so and not is_text(so["signed_off_by"]):
                bad("signed_off_by", "record.sign-off", "sign_off.signed_off_by", "signed_off_by is %s" % show(so["signed_off_by"]),
                    "give the name of the person who said yes")
            if "signed_off_on" in so:
                on = so["signed_off_on"]
                ok = isinstance(on, str) and DATE_RE.match(on)
                if ok:
                    try:
                        datetime.date(int(on[:4]), int(on[5:7]), int(on[8:]))
                    except ValueError:
                        ok = False
                if not ok:
                    bad("signed_off_on", "record.sign-off", "sign_off.signed_off_on", "signed_off_on is %s, not a YYYY-MM-DD date" % show(on),
                        "give the date the user said yes, such as \"2026-11-27\"")
            if "risks" in so:
                problem = risk_list_problem(so["risks"], False)
                if problem:
                    bad("risks", "record.sign-off", "sign_off.risks", "risks " + problem,
                        "list exactly the risks shown to the user when they said yes")
    loop = []
    if "passes" in data:
        loop.extend(check_passes(data, text))
    if "questions" in data:
        loop.extend(check_questions(data, text))
    if not loop and data.get("passes"):
        # Counted only when the passes and questions are otherwise valid: the count reads both.
        loop.extend(check_open_counts(data, text))
    out.extend(loop)
    return sorted(out, key=lambda p: p[0])


def check_passes(data, text):
    """[(line, rule, field, problem, fix)] for the optional passes list."""
    out = []
    line = line_of(text, "passes")

    def bad(field, problem, fix):
        out.append((line, "record.passes", field, problem, fix))

    passes = data["passes"]
    named = set()
    if not isinstance(passes, list) or not 1 <= len(passes) <= MAX_PASSES:
        bad("passes", "passes is %s, not a list of 1 to %d passes" % (show(passes), MAX_PASSES),
            "give one {\"findings\": [...], \"open_blockers\": <n>} per review pass, or leave passes out")
        return out
    for i, p in enumerate(passes, 1):
        field = "passes[%d]" % i
        if not isinstance(p, dict):
            bad(field, "pass %d is %s, not an object" % (i, show(p)), "give {\"findings\": [...], \"open_blockers\": <n>}")
            continue
        missing = [f for f in PASS_FIELDS if f not in p]
        extra = sorted(f for f in p if f not in PASS_FIELDS + OPTIONAL_PASS_FIELDS)
        if missing:
            bad(field, "pass %d is missing %s" % (i, ", ".join(missing)), "add findings and open_blockers")
        if extra:
            bad(field, "pass %d has unknown field%s %s" % (i, "s" if len(extra) > 1 else "", ", ".join(extra)),
                "keep only findings and open_blockers, and optionally words and gates")
        if "words" in p and not (isinstance(p["words"], int) and not isinstance(p["words"], bool) and p["words"] >= 0):
            bad(field + ".words", "words is %s, not a whole number" % show(p["words"]),
                "give the spec's word count as `gate --counts` printed it for this pass")
        if "gates" in p and p["gates"] not in GATE_RESULTS:
            bad(field + ".gates", "gates is %s, not passed or failed" % show(p["gates"]),
                "give passed when `gate` exited 0 on the spec this pass reviewed, failed when it exited 1")
        findings = p.get("findings")
        if "findings" in p and not isinstance(findings, list):
            bad(field + ".findings", "findings is %s, not a list" % show(findings),
                "give the array `findings --merge` printed for this pass")
            findings = None
        valid = []
        if isinstance(findings, list):
            ids = {}
            keys = {}
            for n, f in enumerate(findings, 1):
                ftext = json.dumps(f, ensure_ascii=False)
                problems = FINDINGS.check_finding(f, ftext, 0, len(ftext))
                if problems:
                    _, rule, problem, _ = problems[0]
                    bad("%s.findings[%d]" % (field, n), "finding %d is not valid (%s: %s)" % (n, rule, problem),
                        "record only findings that passed the findings validator")
                    continue
                valid.append(f)
                if f["id"] in ids:
                    bad("%s.findings[%d]" % (field, n), "id %s is already used by finding %d" % (show(f["id"]), ids[f["id"]]),
                        "record the array `findings --merge` printed, which has unique ids")
                else:
                    ids[f["id"]] = n
                key = FINDINGS.dedupe_key(f)
                if key in keys:
                    bad("%s.findings[%d]" % (field, n), "finding %d has the same rule, location and risk as finding %d" % (n, keys[key]),
                        "record the deduplicated array `findings --merge` printed")
                else:
                    keys[key] = n
        if "open_blockers" in p:
            ob = p["open_blockers"]
            if not (isinstance(ob, int) and not isinstance(ob, bool) and ob >= 0):
                bad(field + ".open_blockers", "open_blockers is %s, not a whole number" % show(ob),
                    "set it to the pass's open blockers (open_counts: its blockers, less a slicer.oversized kept in an earlier pass)")
        # A risk a finding raised in any pass stays raised for the rest of the review (v0.8), so every pass counts, not only the last.
        if isinstance(data.get("risk"), dict) and isinstance(data["risk"].get("risks"), list):
            for r in sorted({f["risk"] for f in valid if f["risk"] is not None} - set(data["risk"]["risks"]) - named, key=RISKS.index):
                named.add(r)
                bad(field + ".findings", "a finding in pass %d names risk %s, which risk.risks doesn't list" % (i, r),
                    "a risk a finding raised in any pass stays raised for the rest of the review; "
                    "set risk to what `gate --risk` reports, which reads every pass")
    return out


def check_open_counts(data, text):
    """[(line, rule, field, problem, fix)]: each pass's open_blockers against open_counts, the one counting rule."""
    out = []
    counts = open_counts(data)
    _, carried = resolutions(data)
    for i, (p, count) in enumerate(zip(data["passes"], counts), 1):
        if p["open_blockers"] == count:
            continue
        kept = sum(1 for f in blockers_of(p) if (i, f["id"]) in carried)
        why = " (%s, less %d %s the user answered keep to in an earlier pass)" % (
            plural(len(blockers_of(p)), "blocker"), kept, SKIM_RULE) if kept else ""
        out.append((line_of(text, "passes"), "record.passes", "passes[%d].open_blockers" % i,
                    "open_blockers is %d, but pass %d has %s%s" % (p["open_blockers"], i, plural(count, "open blocker"), why),
                    "set it to %d: a pass's open blockers are its blockers, less a %s blocker the user answered keep to "
                    "in an earlier pass; converge and summary count the same way" % (count, SKIM_RULE)))
    return out


# ---------------------------------------------------------------------------
# Counting open blockers: the one rule the record's open_blockers, converge,
# pause and summary share (v0.8), so the stored count and the verdict can't
# disagree.
# ---------------------------------------------------------------------------

def plural(n, word, many=None):
    return "%d %s" % (n, word if n == 1 else (many or word + "s"))


def blocker_key(finding):
    """The same blocker across passes: rule and section, ignoring case and spacing."""
    return (finding["rule"], FINDINGS._norm(finding["location"]["section"]))


def blockers_of(entry):
    return [f for f in entry["findings"] if f["severity"] == "blocker"]


def resolutions(data):
    """(answered, carried), each keyed by (pass number, finding id), for a valid record.

    answered: the decision blockers whose question in that pass has an
    answer that resolves them (RESOLVING), mapped to the question.
    carried: the slicer's slicer.oversized blockers in a pass after the user
    answered `keep` to it, mapped to that question; they aren't open. Only a
    kept skim answer carries: any other decision raised again may be a new
    question under the same rule and section, so it is open and asked again.
    """
    answered = {}
    for q in data.get("questions") or []:
        if q["trigger"] in ("decision", "skim") and q["finding"] and q["answer"] and q["answer"]["choice"] in RESOLVING:
            answered[(q["pass"], q["finding"])] = q
    carried, earlier = {}, {}
    for p, entry in enumerate(data["passes"], 1):
        decisions = [f for f in blockers_of(entry) if f["kind"] == "decision"]
        for f in decisions:
            if blocker_key(f) in earlier and (p, f["id"]) not in answered:
                carried[(p, f["id"])] = earlier[blocker_key(f)]
        for f in decisions:
            q = answered.get((p, f["id"]))
            if q and q["trigger"] == "skim" and blocker_key(f) not in earlier:
                earlier[blocker_key(f)] = q
    return answered, carried


def open_of(entry, pass_no, carried):
    """The pass's open blockers: its blockers, less the decisions an earlier answer already resolved."""
    return [f for f in blockers_of(entry) if (pass_no, f["id"]) not in carried]


def open_counts(data):
    """The open-blocker count of every pass of a valid record, in order."""
    _, carried = resolutions(data)
    return [len(open_of(p, i, carried)) for i, p in enumerate(data["passes"], 1)]


def question_id(pass_no, trigger, finding):
    """The id a question must have: pass-<n>.<finding id>, pass-<n>.skim or pass-<n>.loop."""
    return "pass-%d.%s" % (pass_no, finding if trigger == "decision" else trigger)


def is_date(value):
    if not (isinstance(value, str) and DATE_RE.match(value)):
        return False
    try:
        datetime.date(int(value[:4]), int(value[5:7]), int(value[8:]))
    except ValueError:
        return False
    return True


def check_questions(data, text):
    """[(line, rule, field, problem, fix)] for the optional questions list (v0.6)."""
    out = []
    line = line_of(text, "questions")

    def bad(field, problem, fix):
        out.append((line, "record.questions", field, problem, fix))

    questions = data["questions"]
    passes = data.get("passes")
    if not isinstance(questions, list):
        bad("questions", "questions is %s, not a list" % show(questions), "give one entry per question asked, or leave questions out")
        return out
    if questions and not (isinstance(passes, list) and passes):
        bad("questions", "questions has entries but the record has no passes", "record the review pass before the questions it raised")
        return out
    seen = {}
    for i, q in enumerate(questions, 1):
        field = "questions[%d]" % i
        if not isinstance(q, dict):
            bad(field, "question %d is %s, not an object" % (i, show(q)), "give {\"id\": ..., \"pass\": ..., ...} as pause printed it")
            continue
        missing = [f for f in QUESTION_FIELDS if f not in q]
        extra = sorted(f for f in q if f not in QUESTION_FIELDS)
        if missing:
            bad(field, "question %d is missing %s" % (i, ", ".join(missing)), "give every field: " + ", ".join(QUESTION_FIELDS))
        if extra:
            bad(field, "question %d has unknown field%s %s" % (i, "s" if len(extra) > 1 else "", ", ".join(extra)),
                "keep only " + ", ".join(QUESTION_FIELDS))
        if missing:
            continue
        trigger, pass_no, finding = q["trigger"], q["pass"], q["finding"]
        if trigger not in TRIGGERS:
            bad(field + ".trigger", "trigger is %s, not one of %s" % (show(trigger), ", ".join(TRIGGERS)), "copy the trigger pause printed")
            continue
        if not (isinstance(pass_no, int) and not isinstance(pass_no, bool) and 1 <= pass_no <= len(passes)):
            bad(field + ".pass", "pass is %s, not a pass of this record (1 to %d)" % (show(pass_no), len(passes)),
                "give the number of the pass the question was asked after")
            continue
        entry = passes[pass_no - 1]
        findings = entry.get("findings") if isinstance(entry, dict) else None
        by_id = dict((f.get("id"), f) for f in findings if isinstance(f, dict)) if isinstance(findings, list) else {}
        if trigger == "loop":
            if finding is not None:
                bad(field + ".finding", "a loop question names finding %s" % show(finding), "set finding to null")
        elif trigger == "skim" and finding is None:
            pass
        else:
            f = by_id.get(finding) if isinstance(finding, str) else None
            if f is None:
                bad(field + ".finding", "finding %s isn't a finding of pass %d" % (show(finding), pass_no),
                    "name the finding id pause printed for this question")
            elif f.get("severity") != "blocker" or f.get("kind") != "decision":
                bad(field + ".finding", "finding %s is a %s %s, not a decision blocker" % (show(finding), f.get("severity"), f.get("kind")),
                    "ask questions only for decision blockers")
            elif trigger == "skim" and f.get("rule") != SKIM_RULE:
                bad(field + ".finding", "a skim question names %s, a %s finding, not %s" % (show(finding), f.get("rule"), SKIM_RULE),
                    "name the slicer's %s blocker, or null for the length ceiling" % SKIM_RULE)
            elif trigger == "decision" and f.get("rule") == SKIM_RULE:
                bad(field + ".trigger", "finding %s is %s, which pause asks as a skim question" % (show(finding), SKIM_RULE),
                    "use trigger skim and id pass-%d.skim" % pass_no)
        want = question_id(pass_no, trigger, finding)
        if q["id"] != want:
            bad(field + ".id", "id is %s, but its pass, trigger and finding make it %s" % (show(q["id"]), show(want)), "use the id pause printed")
        elif want in seen:
            bad(field + ".id", "id %s is already used by question %d" % (show(want), seen[want]), "record each question once, with its answer")
        else:
            seen[want] = i
        if not is_text(q["question"]):
            bad(field + ".question", "question is %s" % show(q["question"]), "copy the question pause printed")
        options = q["options"]
        keys = None
        if not (isinstance(options, list) and all(isinstance(o, dict) and sorted(o) == ["key", "text"] and is_text(o["text"]) for o in options)):
            bad(field + ".options", "options is %s, not a list of {key, text}" % show(options), "copy the options pause printed")
        else:
            keys = tuple(o["key"] for o in options)
            if keys not in OPTION_KEYS[trigger]:
                bad(field + ".options", "a %s question's option keys are %s, not %s" % (
                    trigger, ", ".join(map(str, keys)), " or ".join(", ".join(k) for k in OPTION_KEYS[trigger])),
                    "copy the options pause printed")
                keys = None
        answer = q["answer"]
        if answer is None:
            continue
        if not isinstance(answer, dict):
            bad(field + ".answer", "answer is %s, not null or an object" % show(answer), "use null until the user replies")
            continue
        missing = [f for f in ANSWER_FIELDS if f not in answer]
        extra = sorted(f for f in answer if f not in ANSWER_FIELDS)
        if missing or extra:
            bad(field + ".answer", "answer has %s" % ("no " + ", ".join(missing) if missing else "unknown " + ", ".join(extra)),
                "record exactly choice, words and answered_on, from the user's own reply")
            continue
        if keys is not None and answer["choice"] not in keys:
            bad(field + ".answer.choice", "choice is %s, not one of %s" % (show(answer["choice"]), ", ".join(keys)),
                "record the key of the option the user picked")
        if not is_text(answer["words"]):
            bad(field + ".answer.words", "words is %s" % show(answer["words"]), "record the user's reply, word for word")
        if not is_date(answer["answered_on"]):
            bad(field + ".answer.answered_on", "answered_on is %s, not a YYYY-MM-DD date" % show(answer["answered_on"]),
                "give the date the user replied, such as \"2026-11-27\"")
    return out


def load(path):
    """(data, text, lines, exit code): data is None when the file can't be used."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        return None, None, ["%s:1: error [usage] file: can't read the file (%s). Fix: Pass the path to a specs/reviews/<slug>.json file." % (path, e)], 2
    try:
        data = json.loads(text)
    except ValueError as e:
        return None, text, ["%s:%d: error [parse] file: not JSON (%s). Fix: Correct the file so it parses as a JSON object." % (path, getattr(e, "lineno", 1), getattr(e, "msg", e))], 2
    if not isinstance(data, dict):
        return None, text, ["%s:1: error [parse] file: the top level is %s, not an object. Fix: Make the record one JSON object." % (path, show(data, 20))], 2
    return data, text, [], 0


def check_file(path):
    """(exit code, output lines, the record or None if it isn't valid)."""
    data, text, lines, code = load(path)
    if data is None:
        return code, lines, None
    stem = os.path.splitext(os.path.basename(path))[0]
    problems = check_record(data, text, stem)
    for line, rule, field, problem, fix in problems:
        lines.append("%s:%d: error [%s] %s: %s. Fix: %s." % (path, line, rule, field, problem, fix[0].upper() + fix[1:]))
    if problems:
        lines.append("%s: %d problem%s" % (path, len(problems), "" if len(problems) == 1 else "s"))
        return 1, lines, None
    risk = data["risk"]
    tier = "risk high (%s)" % ", ".join(risk["risks"]) if risk["tier"] == "high" else "risk low"
    so = data["sign_off"]
    signed = "signed off by %s on %s" % (so["signed_off_by"], so["signed_off_on"]) if so else "no sign-off"
    passes = data.get("passes")
    if passes:
        last = passes[-1]["findings"]
        signed += ", %d pass%s: %d finding%s: %s" % (len(passes), "" if len(passes) == 1 else "es", len(last),
                                                   "" if len(last) == 1 else "s", FINDINGS.tally_of(last))
    questions = data.get("questions")
    if questions:
        answered = sum(1 for q in questions if q["answer"] is not None)
        signed += ", %d question%s (%d answered)" % (len(questions), "" if len(questions) == 1 else "s", answered)
    lines.append("%s: ok, %s, %s" % (path, tier, signed))
    return 0, lines, data


def parse_args(argv):
    opts = {"mode": "check", "paths": []}
    for i, arg in enumerate(argv):
        if arg in ("-h", "--help"):
            opts["mode"] = "help"
            return opts
        if arg == "--rules":
            opts["mode"] = "rules"
            return opts
        if arg == "--":
            opts["paths"].extend(argv[i + 1:])
            break
        if arg.startswith("-") and arg != "-":
            raise UsageError("unknown option %r" % arg)
        opts["paths"].append(arg)
    if not opts["paths"]:
        raise UsageError("no record files given")
    return opts


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts = parse_args(argv)
    except UsageError as e:
        sys.stderr.write("record: %s\n%s\n" % (e, USAGE))
        return 2
    if opts["mode"] == "help":
        sys.stdout.write(__doc__.lstrip())
        return 0
    if opts["mode"] == "rules":
        for rule_id, text in RULE_TEXT.items():
            print("  %-18s error   %s" % (rule_id, text))
        return 0
    worst = 0
    for path in opts["paths"]:
        code, lines, _ = check_file(path)
        for line in lines:
            print(line)
        worst = max(worst, code)
    return worst


if __name__ == "__main__":
    sys.exit(main())
