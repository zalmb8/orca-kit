# Gate: secrets (and personal data)
# ---------------------------------------------------------------------------

PLACEHOLDER_RE = re.compile(r"^(<[^>]*>|\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*|\{\{[^}]*\}\}|[*x.X]+|"
                            r"(?i:changeme|redacted|example|placeholder|password|secret|your[-_a-z]*))$")

SECRET_RULES = [
    ("secrets.private-key", re.compile(r"-----BEGIN (?:[A-Z]+ )*PRIVATE KEY(?: BLOCK)?-----"), "a private key"),
    ("secrets.aws-key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"), "an AWS access key ID"),
    ("secrets.github-token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b|\bgithub_pat_[A-Za-z0-9_]{22,}"), "a GitHub token"),
    ("secrets.slack-token", re.compile(r"\bxox[abposr]-[A-Za-z0-9-]{10,}"), "a Slack token"),
    ("secrets.stripe-key", re.compile(r"\b[sr]k_live_[A-Za-z0-9]{16,}"), "a live Stripe key"),
    ("secrets.google-key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}"), "a Google API key"),
    ("secrets.api-key", re.compile(r"\bsk-(?:[a-z]+-)?[A-Za-z0-9_-]{20,}"), "an API key"),
    ("secrets.jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}"), "a JSON Web Token"),
]
URL_CRED_RE = re.compile(r"\b[a-zA-Z][a-zA-Z0-9+.-]*://([^\s:/@]+):([^\s@/]+)@")
ASSIGN_RE = re.compile(r"(?i)\b(?:[a-z0-9_]*[_-])?(password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key|client[_-]?secret)"
                       r"\b[\"']?\s*[:=]\s*[\"'`]?([^\s\"'`,;]+)")
EMAIL_RE = re.compile(r"\b[A-Za-z0-9._%+-]+@((?:[A-Za-z0-9-]+\.)+[A-Za-z]{2,})\b")
EMAIL_OK_DOMAINS = re.compile(r"(?i)(^|\.)(example\.(com|org|net)|example|test|invalid|localhost|users\.noreply\.github\.com)$")
SSN_RE = re.compile(r"\b(?!000|666|9\d\d)\d{3}-(?!00)\d{2}-(?!0000)\d{4}\b")
CARD_RE = re.compile(r"(?<![\d-])[3-6](?:[ -]?\d){12,18}(?![\d-])")
TEST_CARDS = {"4242424242424242", "4111111111111111", "5555555555554444", "378282246310005",
              "6011111111111117", "4000056655665556", "5105105105105100", "4012888888881881"}
PHONE_RE = re.compile(r"(?<![\w+])\+[1-9][0-9]{0,2}(?:[ .-]?\(?[0-9]{1,4}\)?){2,5}(?![\w])")


def luhn(digits):
    total = 0
    for n, d in enumerate(reversed(digits)):
        d = int(d)
        if n % 2:
            d = d * 2 - 9 if d > 4 else d * 2
        total += d
    return total % 10 == 0


def masked(value):
    return value[:4] + "..."


def gate_secrets(path, doc, config, repo):
    out = []

    def bad(no, rule, message, fix):
        out.append(Problem("error", no, doc.section(no), rule, message, fix))

    remove = "remove it from the spec and rotate it if it was ever real; name where the value comes from instead (an env var or secret store)"
    for i, line in enumerate(doc.lines):
        no = i + 1
        for rule, regex, what in SECRET_RULES:
            for m in regex.finditer(line):
                bad(no, rule, "looks like %s (%s)" % (what, masked(m.group(0))), remove)
        for m in URL_CRED_RE.finditer(line):
            if not PLACEHOLDER_RE.match(m.group(2)):
                bad(no, "secrets.url-credentials", "a URL carries a password (%s)" % masked(m.group(0)),
                    "use a placeholder such as `<password>` or `${DB_PASSWORD}`")
        for m in ASSIGN_RE.finditer(line):
            value = m.group(2)
            if len(value) >= 8 and re.search(r"[A-Za-z]", value) and re.search(r"[0-9]", value) and not PLACEHOLDER_RE.match(value):
                bad(no, "secrets.assignment", "%s is set to a literal value (%s)" % (m.group(1).lower(), masked(value)),
                    "use a placeholder such as `<%s>` or `${%s}`" % (m.group(1).lower(), m.group(1).upper().replace("-", "_")))
        for n, regex in enumerate(config["secret_res"]):
            for m in regex.finditer(line):
                bad(no, "secrets.custom", "matches the repo's secret pattern %d (%s)" % (n + 1, masked(m.group(0))), remove)
        for m in EMAIL_RE.finditer(line):
            if not EMAIL_OK_DOMAINS.search(m.group(1)):
                bad(no, "pii.email", "an email address (%s)" % masked(m.group(0)),
                    "use an address at example.com, or describe the person by role")
        for m in SSN_RE.finditer(line):
            bad(no, "pii.ssn", "looks like a social security number (%s)" % masked(m.group(0)),
                "remove it; use an obviously fake value such as `XXX-XX-XXXX`")
        for m in CARD_RE.finditer(line):
            digits = re.sub(r"\D", "", m.group(0))
            if luhn(digits) and digits not in TEST_CARDS and len(set(digits)) > 1:
                bad(no, "pii.card", "looks like a payment card number (%s)" % masked(digits),
                    "remove it; use a well-known test card such as `4242 4242 4242 4242`")
        for m in PHONE_RE.finditer(line):
            digits = re.sub(r"\D", "", m.group(0))
            if 8 <= len(digits) <= 15:
                bad(no, "pii.phone", "looks like a phone number (%s)" % masked(m.group(0)),
                    "remove it; describe the person by role, or use a reserved fictional number")
    return out


