# Gate: blocks
# ---------------------------------------------------------------------------

JSON_INFOS = ("json",)
YAML_INFOS = ("yaml", "yml")
OPENAPI_INFOS = ("openapi",)
SCHEMA_KEYWORDS = {"$schema", "$id", "$comment", "title", "description", "examples", "default",
                   "type", "properties", "required", "additionalProperties", "items", "enum", "const",
                   "pattern", "minLength", "maxLength", "minimum", "maximum", "minItems", "maxItems",
                   "$defs", "definitions", "$ref"}
TYPES = {"object": dict, "array": list, "string": str, "boolean": bool, "null": type(None)}


def no_dupes(pairs):
    out = {}
    for k, v in pairs:
        if k in out:
            raise ValueError("duplicate key %s" % json.dumps(k))
        out[k] = v
    return out


def type_ok(value, t):
    if t == "integer":
        return isinstance(value, int) and not isinstance(value, bool) or (isinstance(value, float) and value.is_integer())
    if t == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    return isinstance(value, TYPES.get(t, ()))


def validate(value, schema, root, where, errors, unsupported):
    """A small JSON Schema subset: the keywords in SCHEMA_KEYWORDS."""
    if schema is True or schema == {}:
        return
    if schema is False:
        errors.append("%s isn't allowed" % where)
        return
    if not isinstance(schema, dict):
        return
    for k in schema:
        if k not in SCHEMA_KEYWORDS:
            unsupported.add(k)
    if "$ref" in schema:
        ref = schema["$ref"]
        target = root
        if isinstance(ref, str) and ref.startswith("#"):
            for part in [p for p in ref[1:].split("/") if p]:
                target = target.get(part) if isinstance(target, dict) else None
        else:
            target = None
        if target is None:
            unsupported.add("$ref %s" % ref)
        else:
            validate(value, target, root, where, errors, unsupported)
    if "type" in schema:
        types = schema["type"] if isinstance(schema["type"], list) else [schema["type"]]
        if not any(type_ok(value, t) for t in types):
            errors.append("%s is %s, not %s" % (where, json_type(value), " or ".join(types)))
            return
    if "enum" in schema and value not in schema["enum"]:
        errors.append("%s is %s, not one of %s" % (where, short(value), ", ".join(short(e) for e in schema["enum"])))
    if "const" in schema and value != schema["const"]:
        errors.append("%s is %s, not %s" % (where, short(value), short(schema["const"])))
    if isinstance(value, str):
        if "pattern" in schema and not re.search(schema["pattern"], value):
            errors.append("%s %s doesn't match %s" % (where, short(value), schema["pattern"]))
        if "minLength" in schema and len(value) < schema["minLength"]:
            errors.append("%s is shorter than %d" % (where, schema["minLength"]))
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            errors.append("%s is longer than %d" % (where, schema["maxLength"]))
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in schema and value < schema["minimum"]:
            errors.append("%s is below %s" % (where, schema["minimum"]))
        if "maximum" in schema and value > schema["maximum"]:
            errors.append("%s is above %s" % (where, schema["maximum"]))
    if isinstance(value, dict):
        props = schema.get("properties", {})
        for k in schema.get("required", []):
            if k not in value:
                errors.append("%s is missing %s" % (where, k))
        for k in sorted(value, key=str):
            if k in props:
                validate(value[k], props[k], root, "%s.%s" % (where, k), errors, unsupported)
            elif "additionalProperties" in schema:
                ap = schema["additionalProperties"]
                if ap is False:
                    errors.append("%s has unknown field %s" % (where, k))
                else:
                    validate(value[k], ap, root, "%s.%s" % (where, k), errors, unsupported)
    if isinstance(value, list):
        if "minItems" in schema and len(value) < schema["minItems"]:
            errors.append("%s has fewer than %d items" % (where, schema["minItems"]))
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            errors.append("%s has more than %d items" % (where, schema["maxItems"]))
        if isinstance(schema.get("items"), (dict, bool)):
            for n, item in enumerate(value):
                validate(item, schema["items"], root, "%s[%d]" % (where, n), errors, unsupported)


def json_type(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "a boolean"
    if isinstance(value, (int, float)):
        return "a number"
    if isinstance(value, str):
        return "a string"
    return "an array" if isinstance(value, list) else "an object"


def short(value, limit=30):
    text = json.dumps(value, ensure_ascii=False, sort_keys=True)
    return text if len(text) <= limit else text[:limit - 3] + "..."


def openapi_problems(doc):
    """[problem text] for an OpenAPI or Swagger document's required top-level fields."""
    out = []
    if not isinstance(doc, dict):
        return ["an OpenAPI document must be a mapping"]
    info = doc.get("info")
    if "swagger" in doc:
        if doc["swagger"] != "2.0":
            out.append("swagger is %s, not \"2.0\"" % short(doc["swagger"]))
        if not isinstance(doc.get("paths"), dict):
            out.append("paths is missing or not a mapping")
    else:
        version = doc.get("openapi")
        if not (isinstance(version, str) and re.match(r"^3\.\d+\.\d+$", version)):
            out.append("openapi is %s, not a version string such as \"3.1.0\"" % ("missing" if version is None else short(version)))
        elif version.startswith("3.0.") and not isinstance(doc.get("paths"), dict):
            out.append("paths is missing or not a mapping")
        elif not version.startswith("3.0.") and not any(isinstance(doc.get(k), dict) for k in ("paths", "components", "webhooks")):
            out.append("none of paths, components or webhooks is a mapping")
    if not isinstance(info, dict):
        out.append("info is missing or not a mapping")
    else:
        for k in ("title", "version"):
            if not isinstance(info.get(k), str):
                out.append("info.%s is %s, not a string" % (k, "missing" if k not in info else json_type(info[k])))
    return out


def gate_blocks(path, doc, config, repo):
    out = []

    def bad(no, rule, message, fix, sev="error"):
        out.append(Problem(sev, no, doc.section(no), rule, message, fix))

    for block in doc.blocks:
        info = block.info
        if info not in JSON_INFOS + YAML_INFOS + OPENAPI_INFOS:
            continue
        text = "\n".join(block.lines)
        first = block.start + 1
        is_json = info in JSON_INFOS or (info in OPENAPI_INFOS and text.lstrip()[:1] == "{")
        if is_json:
            try:
                value = json.loads(text, object_pairs_hook=no_dupes)
            except ValueError as e:
                lineno = getattr(e, "lineno", None)
                bad(first + lineno - 1 if lineno else block.start, "blocks.json",
                    "the ```%s block isn't valid JSON (%s)" % (info, getattr(e, "msg", str(e))),
                    "make it valid JSON, or mark a sketch as ```text")
                continue
        else:
            try:
                value = parse_yaml(text, first)
            except YamlUnsupported as e:
                bad(e.line, "blocks.yaml-unsupported", "the ```%s block isn't checked: %s" % (info, e.message),
                    "rewrite it within the gate's YAML subset, or check it by hand", "warning")
                continue
            except YamlError as e:
                bad(e.line, "blocks.yaml", "the ```%s block isn't valid YAML (%s)" % (info, e.message),
                    "correct the YAML, or mark a sketch as ```text")
                continue
        if info in OPENAPI_INFOS or (isinstance(value, dict) and ("openapi" in value or "swagger" in value)):
            for problem in openapi_problems(value):
                bad(block.start, "blocks.openapi", "the OpenAPI document's %s" % problem,
                    "add the required OpenAPI fields, or mark a fragment as ```text")
        schema_ref = value.get("$schema") if isinstance(value, dict) else None
        if schema_ref is not None:
            check_schema(schema_ref, value, block, repo, bad)
    return out


def check_schema(ref, value, block, repo, bad):
    if not isinstance(ref, str) or re.match(r"^[a-z][a-z0-9+.-]*:", ref, re.I):
        bad(block.start, "blocks.schema-unsupported", "the block's $schema %s isn't checked: only a repo-relative file is" % short(ref),
            "name a schema file in the repo to have it checked, or ignore this", "warning")
        return
    full = os.path.normpath(os.path.join(repo, ref))
    try:
        with open(full, encoding="utf-8") as f:
            schema_text = f.read()
    except (OSError, UnicodeDecodeError):
        bad(block.start, "blocks.schema", "the block names $schema %s, which isn't a readable file in the repo" % short(ref),
            "give the schema's path from the repo root")
        return
    try:
        schema = json.loads(schema_text) if full.endswith(".json") else parse_yaml(schema_text)
    except (ValueError, YamlError) as e:
        bad(block.start, "blocks.schema", "the schema %s doesn't parse (%s)" % (short(ref), getattr(e, "message", e)),
            "correct the schema file")
        return
    errors, unsupported = [], set()
    instance = dict((k, v) for k, v in value.items() if k != "$schema")
    validate(instance, schema, schema, "the block", errors, unsupported)
    for e in errors:
        bad(block.start, "blocks.schema", "against %s, %s" % (ref, e), "make the block match its schema, or correct the schema")
    if unsupported:
        bad(block.start, "blocks.schema-unsupported", "the schema %s uses %s, which the gate doesn't check" % (ref, ", ".join(sorted(unsupported))),
            "check those parts by hand, or ignore this", "warning")


