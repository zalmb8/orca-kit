INLINE_CODE_RE = re.compile(r"(`+)(.+?)\1")


def gate_trace(path, doc, config, repo):
    regex = config["ticket_re"]
    if regex is None:
        return []
    for i in range(doc.body_start, len(doc.lines)):
        if not doc.in_code[i] and regex.search(INLINE_CODE_RE.sub("", doc.lines[i])):
            return []
    goal = next((i + 1 for i in range(doc.body_start, len(doc.lines))
                 if doc.section_of[i] == "Goal & Non-Goals" and H2_RE.match(doc.lines[i])), 1)
    return [Problem("error", goal, doc.section(goal), "trace.ticket",
                    "no ticket matching %s, which %s requires" % (config["ticket_pattern"], CONFIG_PATH),
                    "name the ticket the spec implements in Goal & Non-Goals, outside code, such as 'Ticket: ABC-123'")]


# ---------------------------------------------------------------------------
# Gate: length
# ---------------------------------------------------------------------------

TABLE_SEP_RE = re.compile(r"^:?-{3,}:?$")


def count_words(doc):
    """Words in the body: whitespace-separated tokens, without fence lines or table pipes."""
    n = 0
    for i in range(doc.body_start, len(doc.lines)):
        text = doc.lines[i]
        if FENCE_RE.match(text):
            continue
        if text.lstrip().startswith("|"):
            cells = [c.strip() for c in re.split(r"(?<!\\)\|", text.strip())[1:-1]]
            if cells and all(TABLE_SEP_RE.match(c) for c in cells):
                continue
            text = " ".join(cells)
        n += len(text.split())
    return n


def gate_length(path, doc, config, repo):
    words = count_words(doc)
    ceiling = config["max_words"]
    if words <= ceiling:
        return []
    return [Problem("error", 1, "file", "length.words",
                    "the spec is %d words, over the ceiling of %d" % (words, ceiling),
                    "cut it below %d words or split it into smaller specs; don't fix findings by adding paragraphs" % ceiling)]


GATE_FUNCS = {"check": gate_check, "secrets": gate_secrets, "blocks": gate_blocks,
              "trace": gate_trace, "length": gate_length}


# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------

def format_problem(path, p):
    fix = p.fix[0].upper() + p.fix[1:]
    return "%s:%d: %s [%s] %s: %s. Fix: %s." % (path, p.line, p.severity, p.rule, p.section, p.message, fix)


def gate_file(path, repo_opt):
    """(exit code, output lines) for one spec."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        return 2, ["%s:1: error [usage] file: can't read the file (%s). Fix: Pass the path to a spec .md file." % (path, e)]
    repo = os.path.abspath(repo_opt) if repo_opt else find_repo(path)
    try:
        config, _ = load_config(repo)
    except ConfigError as e:
        cfg = os.path.relpath(os.path.join(repo, CONFIG_PATH))
        return 2, ["%s:%d: error [config] settings: %s. Fix: Correct the settings file; `gate --help` shows the format." % (cfg, e.line, e.message)]
    doc = Doc(text)
    problems = []
    parse_error = False
    failed = {}
    for name in GATES:
        if name == "check":
            found, parse_error = gate_check(path, doc, config, repo)
        else:
            found = GATE_FUNCS[name](path, doc, config, repo)
        errors = sum(1 for p in found if p.severity == "error")
        if errors:
            failed[name] = errors
        problems.extend(found)
    problems.sort(key=lambda p: (p.line, p.rule, p.message))
    lines = [format_problem(path, p) for p in problems]
    passed = [g for g in GATES if g not in failed]
    if failed:
        lines.append("%s: gates failed: %s%s" % (path, ", ".join("%s (%d)" % (g, failed[g]) for g in GATES if g in failed),
                                                 "; passed: " + ", ".join(passed) if passed else ""))
    else:
        lines.append("%s: gates ok: %s" % (path, ", ".join(GATES)))
    return (2 if parse_error else 1 if failed else 0), lines


USAGE = ("usage: gate [--repo ROOT] <spec.md> [<spec.md> ...]\n"
         "       gate --gates")


def parse_args(argv):
    opts = {"mode": "gate", "repo": None, "paths": []}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            opts["mode"] = "help"
            return opts
        if arg == "--gates":
            opts["mode"] = "gates"
            return opts
        if arg == "--repo" or arg.startswith("--repo="):
            if arg == "--repo":
                if i + 1 >= len(argv):
                    raise UsageError("--repo needs a value")
                opts["repo"] = argv[i + 1]
                i += 2
            else:
                opts["repo"] = arg[len("--repo="):]
                i += 1
            continue
        if arg == "--":
            opts["paths"].extend(argv[i + 1:])
            break
        if arg.startswith("-") and arg != "-":
            raise UsageError("unknown option %r" % arg)
        opts["paths"].append(arg)
        i += 1
    if opts["repo"] is not None and not os.path.isdir(opts["repo"]):
        raise UsageError("--repo %r is not a directory" % opts["repo"])
    if not opts["paths"]:
        raise UsageError("no spec files given")
    return opts


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts = parse_args(argv)
    except UsageError as e:
        sys.stderr.write("gate: %s\n%s\n" % (e, USAGE))
        return 2
    if opts["mode"] == "help":
        sys.stdout.write(__doc__.lstrip())
        return 0
    if opts["mode"] == "gates":
        for name in GATES:
            print("%s:" % name)
            for rule_id, text in RULE_TEXT.items():
                if rule_id.split(".")[0] == name or (name == "secrets" and rule_id.startswith("pii.")):
                    sev = "warning" if text.startswith("warning:") else "error"
                    print("  %-26s %-7s %s" % (rule_id, sev, text[len("warning: "):] if sev == "warning" else text))
        return 0
    worst = 0
    for path in opts["paths"]:
        code, lines = gate_file(path, opts["repo"])
        for line in lines:
            print(line)
        worst = max(worst, code)
    return worst


if __name__ == "__main__":
    sys.exit(main())
