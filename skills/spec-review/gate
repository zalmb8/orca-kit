class UsageError(Exception):
    pass


class ConfigError(Exception):
    def __init__(self, message, line=1):
        Exception.__init__(self, message)
        self.message = message
        self.line = line


# ---------------------------------------------------------------------------
# The spec's lines and sections, enough to name where a problem is. The
# checker owns the format; this only tracks frontmatter, `##` headings and
# code fences, the same way it does.
# ---------------------------------------------------------------------------

FENCE_RE = re.compile(r"^(\s*)(`{3,}|~{3,})(.*)$")
H2_RE = re.compile(r"^##(?!#)\s+(.*?)\s*#*\s*$")

Block = namedtuple("Block", "info start lines")  # start: line no. of the opening fence


class Doc(object):
    def __init__(self, text):
        if text.startswith("\ufeff"):
            text = text[1:]
        self.lines = text.split("\n")
        if self.lines and self.lines[-1] == "":
            self.lines.pop()
        self.lines = [ln.rstrip("\r") for ln in self.lines]
        self.section_of = []  # per line, 0-based
        self.in_code = []
        self.blocks = []
        self.body_start = 0  # 0-based index of the first body line
        if self.lines and self.lines[0].rstrip() == "---":
            for i in range(1, len(self.lines)):
                if self.lines[i].rstrip() == "---":
                    self.body_start = i + 1
                    break
        section = "frontmatter" if self.body_start else "(before the first heading)"
        fence = None
        for i, line in enumerate(self.lines):
            if i == self.body_start and self.body_start:
                section = "(before the first heading)"
            if i < self.body_start:
                self.section_of.append("frontmatter")
                self.in_code.append(False)
                continue
            m = FENCE_RE.match(line)
            if fence:
                if m and m.group(2)[0] == fence[1][0] and len(m.group(2)) >= len(fence[1]) and not m.group(3).strip():
                    self.blocks.append(Block(fence[2], fence[0] + 1, fence[3]))
                    fence = None
                else:
                    indent = len(fence[4])
                    stripped = len(line) - len(line.lstrip(" "))
                    fence[3].append(line[min(indent, stripped):])
                self.section_of.append(section)
                self.in_code.append(True)
                continue
            if m:
                info = m.group(3).strip().split()
                fence = (i, m.group(2), info[0].lower() if info else "", [], m.group(1))
                self.section_of.append(section)
                self.in_code.append(True)
                continue
            h = H2_RE.match(line)
            if h:
                section = h.group(1)
            self.section_of.append(section)
            self.in_code.append(False)

    def section(self, lineno):
        if 1 <= lineno <= len(self.section_of):
            return self.section_of[lineno - 1]
        return "file"


# ---------------------------------------------------------------------------
# A strict YAML subset, shared by fenced yaml blocks and the repo config.
#
# Parsed: block mappings and block sequences (including `- key: value`
# items), plain, 'single-quoted' and "double-quoted" single-line scalars,
# single-line flow collections ([a, b], {a: 1}), | and > block scalars, and
# `#` comments. Plain scalars resolve as YAML 1.2 core: null, true/false,
# integers, floats, otherwise strings. Duplicate keys are an error.
#
# Not parsed, and reported as unsupported rather than guessed at: anchors,
# aliases, tags, merge keys, directives, several documents, `?` keys, and
# plain or quoted scalars continued on the next line.
# ---------------------------------------------------------------------------

class YamlError(Exception):
    def __init__(self, line, message):
        Exception.__init__(self, message)
        self.line = line
        self.message = message


class YamlUnsupported(YamlError):
    pass


INT_RE = re.compile(r"^[-+]?(0|[1-9][0-9]*)$|^0o[0-7]+$|^0x[0-9a-fA-F]+$")
FLOAT_RE = re.compile(r"^[-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?$|^[-+]?\.(inf|Inf|INF)$|^\.(nan|NaN|NAN)$")
ESCAPES = {"0": "\0", "a": "\a", "b": "\b", "t": "\t", "\t": "\t", "n": "\n", "v": "\v", "f": "\f",
           "r": "\r", "e": "\x1b", " ": " ", '"': '"', "/": "/", "\\": "\\", "N": "\x85", "_": "\xa0"}
HEX_LEN = {"x": 2, "u": 4, "U": 8}


def resolve_plain(text):
    if text in ("", "~", "null", "Null", "NULL"):
        return None
    if text in ("true", "True", "TRUE"):
        return True
    if text in ("false", "False", "FALSE"):
        return False
    if INT_RE.match(text):
        return int(text, 0) if text[:2] in ("0o", "0x") else int(text)
    if FLOAT_RE.match(text):
        return float(text.lower().replace(".inf", "inf").replace(".nan", "nan"))
    return text


def strip_comment(text):
    """text without a trailing ` # comment` outside quotes."""
    quote = None
    i = 0
    while i < len(text):
        c = text[i]
        if quote == "'":
            if c == "'":
                if i + 1 < len(text) and text[i + 1] == "'":
                    i += 1
                else:
                    quote = None
        elif quote == '"':
            if c == "\\":
                i += 1
            elif c == '"':
                quote = None
        elif c in "'\"" and (i == 0 or text[i - 1] in " \t[{,:-?"):
            quote = c
        elif c == "#" and (i == 0 or text[i - 1] in " \t"):
            return text[:i].rstrip()
        i += 1
    return text.rstrip()


class ScalarReader(object):
    """Reads one inline value (scalar or flow collection) from a string."""

    def __init__(self, text, line):
        self.text = text
        self.i = 0
        self.line = line

    def fail(self, message):
        raise YamlError(self.line, message)

    def ws(self):
        while self.i < len(self.text) and self.text[self.i] in " \t":
            self.i += 1

    def value(self, flow):
        self.ws()
        if self.i >= len(self.text):
            return None
        c = self.text[self.i]
        if c in "&*!":
            raise YamlUnsupported(self.line, "anchors, aliases and tags aren't in the YAML subset")
        if c == "[":
            return self.seq()
        if c == "{":
            return self.map()
        if c == '"':
            return self.double()
        if c == "'":
            return self.single()
        if c in "|>" and not flow:
            self.fail("a block scalar indicator must end the line")
        if c in "@`":
            self.fail("a plain value can't start with %r; quote it" % c)
        if c in "]}," and flow:
            self.fail("unexpected %r" % c)
        return self.plain(flow)

    def plain(self, flow):
        start = self.i
        stops = ",[]{}" if flow else ""
        while self.i < len(self.text):
            c = self.text[self.i]
            if c in stops:
                break
            if c == ":" and (self.i + 1 == len(self.text) or self.text[self.i + 1] in " \t" + stops):
                if flow:
                    break
                self.fail("a value can't contain ': '; quote it")
            self.i += 1
        return resolve_plain(self.text[start:self.i].strip())

    def single(self):
        self.i += 1
        out = []
        while True:
            j = self.text.find("'", self.i)
            if j < 0:
                raise YamlUnsupported(self.line, "a quoted value continued on the next line isn't in the YAML subset (or the quote is never closed)")
            out.append(self.text[self.i:j])
            if self.text[j + 1:j + 2] == "'":
                out.append("'")
                self.i = j + 2
                continue
            self.i = j + 1
            return "".join(out)

    def double(self):
        self.i += 1
        out = []
        while self.i < len(self.text):
            c = self.text[self.i]
            if c == '"':
                self.i += 1
                return "".join(out)
            if c == "\\":
                e = self.text[self.i + 1:self.i + 2]
                if e in ESCAPES:
                    out.append(ESCAPES[e])
                    self.i += 2
                    continue
                if e in HEX_LEN:
                    digits = self.text[self.i + 2:self.i + 2 + HEX_LEN[e]]
                    if len(digits) == HEX_LEN[e] and re.match(r"^[0-9a-fA-F]+$", digits):
                        out.append(chr(int(digits, 16)))
                        self.i += 2 + HEX_LEN[e]
                        continue
                self.fail("invalid escape '\\%s' in a double-quoted value" % e)
            out.append(c)
            self.i += 1
        raise YamlUnsupported(self.line, "a quoted value continued on the next line isn't in the YAML subset (or the quote is never closed)")

    def seq(self):
        self.i += 1
        out = []
        while True:
            self.ws()
            if self.i >= len(self.text):
                raise YamlUnsupported(self.line, "a flow sequence continued on the next line isn't in the YAML subset (or the '[' is never closed)")
            if self.text[self.i] == "]":
                self.i += 1
                return out
            out.append(self.value(True))
            self.ws()
            self.open_at_end("flow sequence", "[")
            if self.text[self.i:self.i + 1] == ",":
                self.i += 1
            elif self.text[self.i:self.i + 1] != "]":
                self.fail("expected ',' or ']' in a flow sequence")

    def map(self):
        self.i += 1
        out = {}
        while True:
            self.ws()
            if self.i >= len(self.text):
                raise YamlUnsupported(self.line, "a flow mapping continued on the next line isn't in the YAML subset (or the '{' is never closed)")
            if self.text[self.i] == "}":
                self.i += 1
                return out
            key = self.value(True)
            self.ws()
            if self.text[self.i:self.i + 1] == ":":
                self.i += 1
                val = self.value(True)
            else:
                val = None
            if not is_hashable(key):
                self.fail("a mapping key must be a scalar")
            if key in out:
                self.fail("duplicate key %s" % json.dumps(key))
            out[key] = val
            self.ws()
            self.open_at_end("flow mapping", "{")
            if self.text[self.i:self.i + 1] == ",":
                self.i += 1
            elif self.text[self.i:self.i + 1] != "}":
                self.fail("expected ',' or '}' in a flow mapping")

    def open_at_end(self, what, bracket):
        if self.i >= len(self.text):
            raise YamlUnsupported(self.line, "a %s continued on the next line isn't in the YAML subset (or the '%s' is never closed)" % (what, bracket))

    def done(self):
        self.ws()
        if self.i < len(self.text):
            self.fail("unexpected text %r after the value" % self.text[self.i:])


def is_hashable(value):
    return value is None or isinstance(value, (str, int, float, bool))


def inline(text, line):
    r = ScalarReader(text, line)
    v = r.value(False)
    r.done()
    return v


KEY_RE = re.compile(r"""^("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^\s#'"\[\]{},&*!|>%@`?-][^#]*?|-[^\s#][^#]*?)[ \t]*:(?:[ \t]+(.*))?$""")
BLOCK_SCALAR_RE = re.compile(r"^([|>])([-+]?)([1-9]?)[-+]?$")


def parse_yaml(text, first_line=1):
    """Parse one YAML document in the subset above. Raises YamlError or YamlUnsupported."""
    rows = []  # (line no., indent, content)
    raw = text.split("\n")
    for n, line in enumerate(raw):
        no = first_line + n
        if "\t" in line[:len(line) - len(line.lstrip(" \t"))]:
            raise YamlError(no, "tab used for indentation")
        content = line.strip()
        if not content or content.startswith("#"):
            rows.append((no, None, line))
            continue
        if line.startswith("%"):
            raise YamlUnsupported(no, "directives aren't in the YAML subset")
        if content in ("---", "...") or content.startswith("--- "):
            if any(r[1] is not None for r in rows) or content != "---":
                raise YamlUnsupported(no, "several documents, or content after '---', aren't in the YAML subset")
            rows.append((no, None, line))
            continue
        rows.append((no, len(line) - len(line.lstrip(" ")), line))
    p = _Parser(rows)
    p.skip()
    if p.i >= len(p.rows):
        return None
    value = p.node(p.rows[p.i][1])
    p.skip()
    if p.i < len(p.rows):
        no, indent, _ = p.rows[p.i]
        raise YamlError(no, "unexpected indentation")
    return value


class _Parser(object):
    def __init__(self, rows):
        self.rows = rows
        self.i = 0

    def skip(self):
        while self.i < len(self.rows) and self.rows[self.i][1] is None:
            self.i += 1

    def node(self, indent):
        self.skip()
        no, ind, line = self.rows[self.i]
        content = line.strip()
        if ind != indent:
            raise YamlError(no, "unexpected indentation")
        if content == "-" or content.startswith("- "):
            return self.sequence(indent)
        if KEY_RE.match(strip_comment(content)):
            return self.mapping(indent)
        if content[:1] == "?":
            raise YamlUnsupported(no, "'?' complex keys aren't in the YAML subset")
        self.i += 1
        value = inline(strip_comment(content), no)
        self.no_continuation(indent - 1, no)
        return value

    def no_continuation(self, indent, no):
        self.skip()
        if self.i < len(self.rows) and self.rows[self.i][1] > indent:
            raise YamlUnsupported(self.rows[self.i][0], "a value continued on the next line isn't in the YAML subset")

    def block_scalar(self, indicator, parent_indent, no):
        m = BLOCK_SCALAR_RE.match(indicator)
        if not m:
            raise YamlError(no, "malformed block scalar indicator %r" % indicator)
        lines = []
        self.i += 1
        block_indent = None
        while self.i < len(self.rows):
            rno, ind, line = self.rows[self.i]
            if ind is None:
                if line.strip() and block_indent is not None and len(line) - len(line.lstrip(" ")) >= block_indent:
                    lines.append(line[block_indent:])
                else:
                    lines.append("")
                self.i += 1
                continue
            if ind <= parent_indent:
                break
            if block_indent is None:
                block_indent = ind
            if ind < block_indent:
                raise YamlError(rno, "a block scalar line is less indented than the first")
            lines.append(line[block_indent:])
            self.i += 1
        while lines and lines[-1] == "":
            lines.pop()
        joiner = "\n" if m.group(1) == "|" else " "
        return joiner.join(lines) + ("" if m.group(2) == "-" or not lines else "\n")

    def value_after(self, rest, indent, no, child_min):
        """The value of `key:` or `-` whose inline remainder is rest."""
        rest = strip_comment(rest or "")
        if rest and rest[0] in "|>":
            return self.block_scalar(rest, indent, no)
        if rest:
            self.i += 1
            if rest[:1] in "&*!":
                raise YamlUnsupported(no, "anchors, aliases and tags aren't in the YAML subset")
            value = inline(rest, no)
            self.no_continuation(indent, no)
            return value
        self.i += 1
        self.skip()
        if self.i < len(self.rows):
            nno, nind, nline = self.rows[self.i]
            nested_seq = nline.strip() == "-" or nline.strip().startswith("- ")
            if nind > indent or (nind == indent and nested_seq and child_min == indent):
                return self.node(nind)
        return None

    def mapping(self, indent):
        out = {}
        while True:
            self.skip()
            if self.i >= len(self.rows):
                return out
            no, ind, line = self.rows[self.i]
            if ind < indent:
                return out
            if ind > indent:
                raise YamlError(no, "unexpected indentation")
            content = strip_comment(line.strip())
            if content == "-" or content.startswith("- "):
                raise YamlError(no, "a sequence item where a mapping key was expected")
            m = KEY_RE.match(content)
            if not m:
                if content[:1] == "?":
                    raise YamlUnsupported(no, "'?' complex keys aren't in the YAML subset")
                raise YamlError(no, "expected 'key: value'")
            key = inline(m.group(1), no)
            if key == "<<":
                raise YamlUnsupported(no, "merge keys aren't in the YAML subset")
            if not is_hashable(key):
                raise YamlError(no, "a mapping key must be a scalar")
            if key in out:
                raise YamlError(no, "duplicate key %s" % json.dumps(key))
            out[key] = self.value_after(m.group(2), indent, no, indent)

    def sequence(self, indent):
        out = []
        while True:
            self.skip()
            if self.i >= len(self.rows):
                return out
            no, ind, line = self.rows[self.i]
            if ind < indent:
                return out
            content = line.strip()
            if ind > indent:
                raise YamlError(no, "unexpected indentation")
            if not (content == "-" or content.startswith("- ")):
                return out  # the next key of the mapping this sequence belongs to
            rest = content[1:].lstrip(" ")
            item_indent = ind + (len(content) - len(rest))
            if rest and KEY_RE.match(strip_comment(rest)):
                # `- key: value`: a mapping whose first key sits after the dash.
                self.rows[self.i] = (no, item_indent, " " * item_indent + rest)
                out.append(self.mapping(item_indent))
                continue
            if rest.startswith("- ") or rest == "-":
                self.rows[self.i] = (no, item_indent, " " * item_indent + rest)
                out.append(self.sequence(item_indent))
                continue
            out.append(self.value_after(rest, indent, no, None))


