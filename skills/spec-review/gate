def find_repo(spec_path):
    d = os.path.dirname(os.path.abspath(spec_path))
    while True:
        if os.path.exists(os.path.join(d, ".orca-kit")) or os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return os.path.dirname(os.path.abspath(spec_path))
        d = parent


def compile_pattern(value, where):
    if not isinstance(value, str) or not value:
        raise ConfigError("%s must be a non-empty quoted regex" % where)
    try:
        return re.compile(value)
    except re.error as e:
        raise ConfigError("%s %s isn't a valid regex (%s)" % (where, json.dumps(value), e))


def load_config(repo):
    """(config dict, path or None). Raises ConfigError."""
    path = os.path.join(repo, CONFIG_PATH)
    config = dict(DEFAULTS)
    config["ticket_re"] = None
    config["secret_res"] = []
    if not os.path.isfile(path):
        return config, None
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise ConfigError("can't read it (%s)" % e)
    try:
        data = parse_yaml(text)
    except YamlError as e:
        raise ConfigError(e.message, e.line)
    if data is None:
        return config, path
    if not isinstance(data, dict):
        raise ConfigError("the top level must be a mapping of settings")
    unknown = sorted(str(k) for k in data if k not in DEFAULTS)
    if unknown:
        raise ConfigError("unknown setting%s %s; the settings are %s" % (
            "s" if len(unknown) > 1 else "", ", ".join(unknown), ", ".join(DEFAULTS)))
    if data.get("ticket_pattern") is not None:
        config["ticket_pattern"] = data["ticket_pattern"]
        config["ticket_re"] = compile_pattern(data["ticket_pattern"], "ticket_pattern")
    if "max_words" in data:
        mw = data["max_words"]
        if not (isinstance(mw, int) and not isinstance(mw, bool) and mw >= 1):
            raise ConfigError("max_words must be a whole number of at least 1, not %s" % json.dumps(mw))
        config["max_words"] = mw
    if data.get("secret_patterns") is not None:
        sp = data["secret_patterns"]
        if not isinstance(sp, list):
            raise ConfigError("secret_patterns must be a list of quoted regexes")
        config["secret_patterns"] = sp
        config["secret_res"] = [compile_pattern(p, "secret_patterns item %d" % (n + 1)) for n, p in enumerate(sp)]
    return config, path


# ---------------------------------------------------------------------------
# Gate: check
# ---------------------------------------------------------------------------

CHECK_LINE_RE = re.compile(r"^(?P<file>.*?):(?P<line>\d+): (?P<sev>error|warning) \[(?P<rule>[^\]]+)\] (?P<section>[^:]+): (?P<message>.*?)\. Fix: (?P<fix>.*)\.$")
CHECK_OK_RE = re.compile(r"^.*: ok \(.*\)(, \d+ warnings?)?$")


def gate_check(path, doc, config, repo):
    """[Problem], and whether the checker found a parse error."""
    try:
        result = subprocess.run([sys.executable, os.path.normpath(CHECK), "--as", "accepted", "--", path],
                                capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        return [Problem("error", 1, "file", "check.run", "the spec checker didn't run (%s)" % e,
                        "make sure %s exists and python3 can run it" % os.path.normpath(CHECK))], False
    out = []
    parse_error = False
    unknown = []
    for line in result.stdout.splitlines():
        m = CHECK_LINE_RE.match(line)
        if m:
            if m.group("rule") == "parse":
                parse_error = True
            out.append(Problem(m.group("sev"), int(m.group("line")), m.group("section"), "check." + m.group("rule"),
                               m.group("message"), m.group("fix")))
        elif not CHECK_OK_RE.match(line):
            unknown.append(line)
    if result.returncode not in (0, 1, 2) or unknown or (result.returncode != 0 and not any(p.severity == "error" for p in out)):
        detail = (unknown or result.stderr.strip().splitlines() or ["exit %d" % result.returncode])[0]
        out.append(Problem("error", 1, "file", "check.run", "the spec checker gave unexpected output (%s)" % detail.rstrip("."),
                           "run skills/spec/check --as accepted on the spec and fix what it reports"))
    return out, parse_error


