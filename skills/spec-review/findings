#!/usr/bin/env python3
"""Validate orca-kit:spec-review findings files, and summarise them by severity.

Usage:
  findings <findings.json> [<findings.json> ...]
  findings --merge <findings.json> [<findings.json> ...]
  findings --stats [--repo ROOT]
  findings --rules

  --merge       Validate every file, then print one JSON array on stdout: the
                valid findings of all the files, in order, deduplicated
                (below). Everything else goes to stderr. Used to combine the
                five reviewers' outputs into one review pass (v0.4).
  --stats       Count findings by rule across every specs/reviews/*.json of
                the repo, and propose graduating repeated, mechanical rules
                (below; v0.7).
  --repo ROOT   With --stats: the repo. Default: the nearest directory at or
                above the current one with .orca-kit/ or .git.
  --rules       List the rules each finding is checked against, and exit.

A findings file is a JSON array of finding objects, in the format of
findings.schema.json next to this script (docs/spec-review/ROADMAP.md,
"Findings format"). Every field is required; `location.line`,
`location.ref` and `risk` may be null.

Severity is two levels, each mapped to one action (v0.5): `blocker` means
the spec can't be built or tested as written without someone guessing (a
`fix` goes back to the author, a `decision` to the user); `nit` is a
comment, with no action required. The level is fixed by the rule, not
chosen per finding: every rule key is declared a blocker rule or a nit rule
in the rubric table of its reviewer's agent file
(agents/spec-review-<reviewer>.md, `| `<rule>` | <blocker|nit> | ... |`),
which is the one rule table this script, the agents and the tests read. A
finding whose rule isn't in that table, or whose severity isn't its rule's
level, is rejected.

Prints one line per rejected finding problem:
  <file>:<line>: error [<rule>] finding #<n> (<id>): <problem>. Fix: <what to do>.
where <n> counts findings from 1 and <line> is the line of the offending
field in the file. Then one summary line per file, counting only the
findings that passed:
  <file>: ok, <n> findings: <b> blocker (<d> decision), <k> nit
  <file>: <r> rejected, <n> kept: <b> blocker (<d> decision), <k> nit

A rejected finding is dropped, never repaired or guessed at.

Exit codes: 0 every finding in every file is valid, 1 a finding is rejected,
2 a usage error or a file that isn't a JSON array.

--merge. Files are read in the order given; a rejected finding, or every
finding of a file that can't be read or isn't a JSON array, is dropped and
reported, and the merge goes on with the rest. A finding whose id is already
used by a finding in an earlier file is rejected under finding.id. Two
findings are duplicates when they have the same rule, the same location (the
section, ignoring case and runs of whitespace; the same line, or both null;
the same ref, ignoring case, or both null) and the same risk, so a merge never
drops a risk. Of each set of duplicates a decision is kept over a fix,
then the first given (duplicates share a rule, so they share a severity);
it takes the place of the first of the set. Each dropped duplicate is
reported on stderr as
  <file>:<line>: note [merge.duplicate] finding #<n> (<id>): same rule and location as <id> in <file>, dropped.
then one line:
  merged: <n> findings from <f> files: <b> blocker (<d> decision), <k> nit; <u> duplicates dropped, <r> rejected
The exit code is the worst of the files' (0, 1 or 2), or 1 for an id clash;
stdout is always a valid findings array.

--stats. Every specs/reviews/*.json under the repo is checked with the
record validator (`record`), in file-name order. A record it rejects is
reported, with record's own problem lines, then
  <file>: not counted: the record isn't valid
and none of its findings is counted. Every pass of every valid record is
counted (a record holds one review, since a fresh review replaces its
passes; the last pass alone would miss every blocker the loop fixed). Each
rule gets two counts: its findings, and the specs it was seen in. The specs
count is the one that matters: one spec reviewed many times, or one noisy
pass, is still one spec. A table follows, most specs first, then most
findings, then by rule:
  rule                   level    graduates        findings  specs
  ambiguity.weasel-word  blocker  check                   5      3

A rule is proposed when its rubric row marks it a graduation candidate (the
Graduates column: `check`, the spec checker; `secret_patterns` or
`risk_terms`, the gate config) and it was seen in at least graduate_after
specs (.orca-kit/spec-review.yml, default 3). A rule marked `no` is a
judgement call and is never proposed, however often it is seen. Each
proposal is
  graduate <n>: <rule> (<level>): seen in <s> specs (<slugs>), <f> findings; enforce in <where>
  example: <record> pass <p>, <id>, <section> line <l> <ref>: "<evidence>"
(one example per spec: its first finding of the rule), then a draft check
when the evidence shows a literal pattern: the phrases of 1 to 3 words the
evidence of at least graduate_after specs shares (not only common words,
no digits, none containing a shorter such phrase), as a regex for the
checker or a list for the config. Otherwise a `draft: none` line. A draft
is a starting point for the user, never applied: no script changes the
checker, the config or the agents. Last line:
  stats: <r> records counted (<p> passes, <f> findings), <i> not counted; <k> proposals (graduate_after <n>)
Exit 0 when every record is valid, else the worst record's exit code (1 a
rule, 2 not JSON); 2 for a usage error or an invalid settings file.

Python 3 standard library only; no install step. No mode writes a file.
"""

import glob
import json
import os
import re
import sys

# ---------------------------------------------------------------------------
# The findings format. findings.schema.json states the same thing as JSON
# Schema; tests/test_findings.py checks that the two agree.
# ---------------------------------------------------------------------------

SEVERITIES = ("blocker", "nit")
KINDS = ("fix", "decision")
RISKS = ("auth", "security-boundary", "data-model", "migration", "billing", "public-api", "breaking-change")
FIELDS = ("id", "reviewer", "severity", "kind", "rule", "location", "evidence",
          "concrete_question", "suggested_fix", "risk")
LOCATION_FIELDS = ("section", "line", "ref")

ID_RE = re.compile(r"^[a-z0-9][a-z0-9.-]*$")
REVIEWER_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
RULE_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*(\.[a-z0-9]+(-[a-z0-9]+)*)+$")

RULE_TEXT = {
    "finding.object": "each finding is a JSON object",
    "finding.fields": "no fields other than " + ", ".join(FIELDS),
    "finding.id": "id is lowercase letters, digits, '.' and '-', and unique in the file",
    "finding.reviewer": "reviewer is a lowercase, hyphenated name",
    "finding.severity": "severity is " + " | ".join(SEVERITIES) + ", and equals the level the rule table declares for its rule",
    "finding.kind": "kind is " + " | ".join(KINDS),
    "finding.rule": "rule is '<reviewer>.<key>', a key in the rubric table of agents/spec-review-<reviewer>.md",
    "finding.location": "location is an object with section (text), line (integer >= 1 or null) and ref (text or null)",
    "finding.evidence": "evidence is non-empty text",
    "finding.concrete-question": "concrete_question is non-empty text ending in '?'",
    "finding.suggested-fix": "suggested_fix is non-empty text",
    "finding.risk": "risk is null or " + " | ".join(RISKS),
}

# What to do about a missing field. A missing field is reported under that
# field's own rule, so "no location" reads as a location problem.
MISSING_FIX = {
    "id": "add an id unique in the file, such as \"ambiguity-3\"",
    "reviewer": "add the reviewer's name, such as \"ambiguity\"",
    "severity": "add severity: blocker or nit, the level the rule table gives its rule",
    "kind": "add kind: fix or decision",
    "rule": "add the rubric's rule key, such as \"ambiguity.weasel-word\"",
    "location": "add location: {\"section\": ..., \"line\": ..., \"ref\": ...}, with null for an unknown line or ref",
    "evidence": "add evidence: the spec text the finding is about",
    "concrete_question": "add concrete_question: the one question that resolves the finding",
    "suggested_fix": "add suggested_fix: what to change in the spec",
    "risk": "add risk: null, or the risk area the finding touches",
}


# ---------------------------------------------------------------------------
# The rule table: each reviewer agent's rubric declares every rule key as a
# blocker rule or a nit rule. This is the only place levels are written down.
# ---------------------------------------------------------------------------

HERE = os.path.dirname(os.path.realpath(__file__))
AGENTS_DIR = os.path.normpath(os.path.join(HERE, "..", "..", "agents"))
# v0.7 adds a Graduates column; a table without it (v0.5) still parses, and
# then none of its rules is a graduation candidate.
RUBRIC_HEADER_RE = re.compile(r"^\| Rule \| Level \| (?:Graduates \| )?Report when \|$", re.M)
RULE_KEY = r"[a-z0-9]+(?:-[a-z0-9]+)*\.[a-z0-9]+(?:-[a-z0-9]+)*"
RUBRIC_ROW_RE = re.compile(r"^\| `(%s)` \| (blocker|nit) \| .+ \|$" % RULE_KEY)
# Graduates: where a repeated finding of the rule would be enforced as a
# deterministic rule (v0.7, `--stats`), or `no` for a judgement call. Only a
# rule whose detection could be a string, pattern or structure check is
# marked; the marker is read here, never decided per finding.
GRADUATES = ("no", "check", "secret_patterns", "risk_terms")
RUBRIC_ROW_GRADUATES_RE = re.compile(r"^\| `(%s)` \| (blocker|nit) \| (%s) \| .+ \|$" % (RULE_KEY, "|".join(GRADUATES)))


class RuleTableError(Exception):
    pass


def read_rule_rows(agents_dir=AGENTS_DIR):
    """{rule: (level, graduates)} from every agents/spec-review-*.md rubric. Raises RuleTableError."""
    table = {}
    paths = sorted(glob.glob(os.path.join(agents_dir, "spec-review-*.md")))
    if not paths:
        raise RuleTableError("no reviewer agent files (spec-review-*.md) in %s" % agents_dir)
    for path in paths:
        reviewer = os.path.basename(path)[len("spec-review-"):-len(".md")]
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            raise RuleTableError("can't read %s (%s)" % (path, e))
        m = re.search(r"^## Rubric\n(.*?)(?=^## |\Z)", text, re.S | re.M)
        header = RUBRIC_HEADER_RE.search(m.group(1)) if m else None
        if not header:
            raise RuleTableError("%s has no `| Rule | Level | Graduates | Report when |` table under ## Rubric" % path)
        with_graduates = "Graduates" in header.group(0)
        rows = 0
        for line in m.group(1).split("\n"):
            if not line.startswith("| `"):
                continue
            if with_graduates:
                row = RUBRIC_ROW_GRADUATES_RE.match(line)
                if not row:
                    raise RuleTableError("%s: rubric row %r isn't `| `<rule>` | blocker or nit | %s | <when> |`" % (
                        path, line[:60], " or ".join(GRADUATES)))
                rule, level, graduates = row.groups()
            else:
                row = RUBRIC_ROW_RE.match(line)
                if not row:
                    raise RuleTableError("%s: rubric row %r isn't `| `<rule>` | blocker or nit | <when> |`" % (path, line[:60]))
                (rule, level), graduates = row.groups(), "no"
            if not rule.startswith(reviewer + "."):
                raise RuleTableError("%s: rule %s isn't prefixed with %s." % (path, rule, reviewer))
            if rule in table:
                raise RuleTableError("%s: rule %s is listed twice" % (path, rule))
            table[rule] = (level, graduates)
            rows += 1
        if not rows:
            raise RuleTableError("%s: the rubric table has no rules" % path)
    return table


def read_rule_table(agents_dir=AGENTS_DIR):
    """{rule: level} from every agents/spec-review-*.md rubric. Raises RuleTableError."""
    return dict((rule, level) for rule, (level, _) in read_rule_rows(agents_dir).items())


_RULE_ROWS = None


def rule_rows():
    global _RULE_ROWS
    if _RULE_ROWS is None:
        _RULE_ROWS = read_rule_rows()
    return _RULE_ROWS


_RULE_TABLE = None


def rule_table():
    global _RULE_TABLE
    if _RULE_TABLE is None:
        _RULE_TABLE = dict((rule, level) for rule, (level, _) in rule_rows().items())
    return _RULE_TABLE


def rule_of(field):
    return "finding." + field.replace("_", "-")


USAGE = ("usage: findings <findings.json> [<findings.json> ...]\n"
         "       findings --merge <findings.json> [<findings.json> ...]\n"
         "       findings --stats [--repo ROOT]\n"
         "       findings --rules")


class UsageError(Exception):
    pass


def show(value, limit=40):
    text = json.dumps(value, ensure_ascii=False)
    return text if len(text) <= limit else text[:limit - 3] + "..."


def is_text(value):
    return isinstance(value, str) and value.strip() != ""


def is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def line_of(text, offset):
    return text.count("\n", 0, offset) + 1


def elements(text):
    """[(value, start offset, end offset)] for each element of the top-level JSON array.

    Raises ValueError (json.JSONDecodeError) if the text isn't JSON, and
    TypeError if it is JSON but not an array.
    """
    whole = json.loads(text)
    if not isinstance(whole, list):
        raise TypeError("the top level is %s, not an array of findings" % type(whole).__name__.replace("dict", "an object"))
    decoder = json.JSONDecoder()
    ws = re.compile(r"[ \t\n\r]*")
    i = ws.match(text, 0).end() + 1  # past the '['
    found = []
    while len(found) < len(whole):
        i = ws.match(text, i).end()
        if text[i] == ",":
            i = ws.match(text, i + 1).end()
        value, end = decoder.raw_decode(text, i)
        found.append((value, i, end))
        i = end
    return found


def field_line(text, start, end, name):
    """The line of `"name":` inside text[start:end], or of start if it isn't there."""
    m = re.compile(r'"%s"\s*:' % re.escape(name)).search(text, start, end)
    return line_of(text, m.start() if m else start)


def check_finding(finding, text, start, end):
    """[(line, rule, problem, fix)] for one finding."""
    out = []

    def bad(name, rule, problem, fix):
        out.append((field_line(text, start, end, name) if name else line_of(text, start), rule, problem, fix))

    if not isinstance(finding, dict):
        bad(None, "finding.object", "it is %s, not an object" % show(finding),
            "make each element of the array a finding object")
        return out
    for name in FIELDS:
        if name not in finding:
            bad(None, rule_of(name), "%s is missing" % name, MISSING_FIX[name])
    extra = sorted(f for f in finding if f not in FIELDS)
    if extra:
        bad(extra[0], "finding.fields", "unknown field%s %s" % ("s" if len(extra) > 1 else "", ", ".join(extra)),
            "remove it, or rename it to one of " + ", ".join(FIELDS))

    def has(name):
        return name in finding

    if has("id") and not (isinstance(finding["id"], str) and ID_RE.match(finding["id"])):
        bad("id", "finding.id", "id is %s" % show(finding["id"]),
            "use a lowercase id such as \"ambiguity-3\"")
    if has("reviewer") and not (isinstance(finding["reviewer"], str) and REVIEWER_RE.match(finding["reviewer"])):
        bad("reviewer", "finding.reviewer", "reviewer is %s" % show(finding["reviewer"]),
            "use the reviewer's lowercase, hyphenated name, such as \"ambiguity\"")
    if has("severity") and finding["severity"] not in SEVERITIES:
        bad("severity", "finding.severity", "severity is %s, not one of %s" % (show(finding["severity"]), ", ".join(SEVERITIES)),
            "use blocker or nit, as the rule decides" + ("; warning is no longer a severity" if finding["severity"] == "warning" else ""))
    if has("kind") and finding["kind"] not in KINDS:
        bad("kind", "finding.kind", "kind is %s, not one of %s" % (show(finding["kind"]), ", ".join(KINDS)),
            "use fix if the author can resolve it from the spec and repo, or decision if it needs the user")
    if has("rule"):
        rule = finding["rule"]
        reviewer = finding.get("reviewer")
        if not (isinstance(rule, str) and RULE_RE.match(rule)):
            bad("rule", "finding.rule", "rule is %s" % show(rule),
                "use '<reviewer>.<key>', such as \"ambiguity.weasel-word\"")
        elif isinstance(reviewer, str) and REVIEWER_RE.match(reviewer) and not rule.startswith(reviewer + "."):
            bad("rule", "finding.rule", "rule %s doesn't start with the reviewer %s" % (show(rule), show(reviewer + ".")),
                "prefix the rubric's key with the reviewer's name")
        elif rule not in rule_table():
            prefix = rule.split(".")[0] + "."
            known = sorted(r for r in rule_table() if r.startswith(prefix))
            bad("rule", "finding.rule", "rule %s isn't in the rule table" % show(rule),
                ("use one of " + ", ".join(known)) if known else "use a rule from a reviewer agent's rubric table")
        elif has("severity") and finding["severity"] in SEVERITIES and finding["severity"] != rule_table()[rule]:
            level = rule_table()[rule]
            bad("severity", "finding.severity", "severity is %s, but %s is a %s rule" % (show(finding["severity"]), rule, level),
                "set severity to %s; the rule fixes the level, a finding never chooses it" % level)
    if has("location"):
        loc = finding["location"]
        if not isinstance(loc, dict):
            bad("location", "finding.location", "location is %s, not an object" % show(loc),
                "give {\"section\": ..., \"line\": ..., \"ref\": ...}")
        else:
            missing = [f for f in LOCATION_FIELDS if f not in loc]
            extra = sorted(f for f in loc if f not in LOCATION_FIELDS)
            if missing:
                bad("location", "finding.location", "location is missing " + ", ".join(missing),
                    "add section, line and ref; use null for an unknown line or ref")
            if extra:
                bad("location", "finding.location", "location has unknown field%s %s" % ("s" if len(extra) > 1 else "", ", ".join(extra)),
                    "keep only section, line and ref")
            if "section" in loc and not is_text(loc["section"]):
                bad("location", "finding.location", "location.section is %s" % show(loc["section"]),
                    "name the spec section the finding is about, such as \"Behavior & Edge Cases\"")
            if "line" in loc and loc["line"] is not None and not (is_int(loc["line"]) and loc["line"] >= 1):
                bad("location", "finding.location", "location.line is %s" % show(loc["line"]),
                    "give the spec line number, counting from 1, or null")
            if "ref" in loc and loc["ref"] is not None and not is_text(loc["ref"]):
                bad("location", "finding.location", "location.ref is %s" % show(loc["ref"]),
                    "give the AC, decision or edge-case ID, such as \"AC-3\", or null")
    for name, rule, fix in (("evidence", "finding.evidence", "quote the spec text the finding is about"),
                            ("suggested_fix", "finding.suggested-fix", "say what to change in the spec")):
        if has(name) and not is_text(finding[name]):
            bad(name, rule, "%s is %s" % (name, show(finding[name])), fix)
    if has("concrete_question"):
        q = finding["concrete_question"]
        if not is_text(q):
            bad("concrete_question", "finding.concrete-question", "concrete_question is %s" % show(q),
                "ask the one question that resolves the finding")
        elif not q.rstrip().endswith("?"):
            bad("concrete_question", "finding.concrete-question", "concrete_question %s isn't a question" % show(q),
                "phrase it as one question ending in '?'")
    if has("risk") and finding["risk"] is not None and finding["risk"] not in RISKS:
        bad("risk", "finding.risk", "risk is %s, not null or one of %s" % (show(finding["risk"]), ", ".join(RISKS)),
            "use null, or the risk area the finding touches")
    return out


def check_file(path):
    """(exit code, output lines) for one findings file."""
    code, lines, _ = check_file_kept(path)
    return code, lines


def check_file_kept(path):
    """(exit code, output lines, [(n, finding, line)] of the findings that passed)."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        return 2, ["%s:1: error [usage] file: can't read the file (%s). Fix: Pass the path to a findings .json file." % (path, e)], []
    try:
        items = elements(text)
    except ValueError as e:
        return 2, ["%s:%d: error [parse] file: not JSON (%s). Fix: Correct the file so it parses as a JSON array of findings." % (path, getattr(e, "lineno", 1), getattr(e, "msg", e))], []
    except TypeError as e:
        return 2, ["%s:1: error [parse] file: %s. Fix: Wrap the findings in a JSON array." % (path, e)], []

    lines = []
    kept = []
    rejected = 0
    seen = {}
    for n, (finding, start, end) in enumerate(items, 1):
        problems = check_finding(finding, text, start, end)
        fid = finding.get("id") if isinstance(finding, dict) else None
        valid_id = isinstance(fid, str) and ID_RE.match(fid)
        if valid_id:
            if fid in seen:
                problems.append((field_line(text, start, end, "id"), "finding.id",
                                 "id %s is already used by finding #%d" % (show(fid), seen[fid]),
                                 "give each finding its own id"))
            else:
                seen[fid] = n
        where = "finding #%d (%s)" % (n, fid) if valid_id else "finding #%d" % n
        for line, rule, problem, fix in sorted(problems, key=lambda p: p[0]):
            lines.append("%s:%d: error [%s] %s: %s. Fix: %s." % (path, line, rule, where, problem, fix[0].upper() + fix[1:]))
        if problems:
            rejected += 1
        else:
            kept.append((n, finding, line_of(text, start)))

    tally = tally_of([f for _, f, _ in kept])
    if rejected:
        lines.append("%s: %d rejected, %d kept: %s" % (path, rejected, len(kept), tally))
    else:
        lines.append("%s: ok, %d finding%s: %s" % (path, len(kept), "" if len(kept) == 1 else "s", tally))
    return (1 if rejected else 0), lines, kept


def tally_of(findings):
    count = dict((s, sum(1 for f in findings if f["severity"] == s)) for s in SEVERITIES)
    decisions = sum(1 for f in findings if f["severity"] == "blocker" and f["kind"] == "decision")
    return "%d blocker (%d decision), %d nit" % (count["blocker"], decisions, count["nit"])


# ---------------------------------------------------------------------------
# --merge: combine reviewers' files into one deduplicated array.
# ---------------------------------------------------------------------------

MERGE_RULE_TEXT = {
    "merge.duplicate": "note: same rule, location (section, line, ref) and risk as a kept finding; a decision, "
                       "then the first is kept",
}


def _norm(text):
    return " ".join(text.split()).casefold()


def dedupe_key(finding):
    """Findings with equal keys are duplicates: rule, location and risk (a valid finding only)."""
    loc = finding["location"]
    return (finding["rule"], _norm(loc["section"]), loc["line"],
            None if loc["ref"] is None else _norm(loc["ref"]), finding["risk"])


def _preference(finding, order):
    return (SEVERITIES.index(finding["severity"]), 0 if finding["kind"] == "decision" else 1, order)


def dedupe(findings):
    """(kept, [(dropped, kept instead)]) for valid findings, in order. Deterministic."""
    groups = {}
    keys = []
    for order, f in enumerate(findings):
        key = dedupe_key(f)
        if key not in groups:
            groups[key] = []
            keys.append(key)
        groups[key].append((order, f))
    kept, dropped = [], []
    for key in keys:
        best = min(groups[key], key=lambda of: _preference(of[1], of[0]))
        kept.append(best[1])
        dropped.extend((f, best[1]) for order, f in groups[key] if order != best[0])
    return kept, dropped


def merge(paths):
    """(exit code, merged findings, stderr lines) for `--merge`."""
    worst, lines, entries, seen_ids, rejected = 0, [], [], {}, 0
    for path in paths:
        code, file_lines, kept = check_file_kept(path)
        worst = max(worst, code)
        lines.extend(file_lines)
        if code == 1:
            m = re.search(r": (\d+) rejected, ", file_lines[-1])
            rejected += int(m.group(1)) if m else 0
        for n, finding, line in kept:
            fid = finding["id"]
            if fid in seen_ids:
                lines.append("%s:%d: error [finding.id] finding #%d (%s): id %s is already used in %s. "
                             "Fix: Give each finding an id unique across the files merged, such as \"<reviewer>-<n>\"." % (
                                 path, line, n, fid, show(fid), seen_ids[fid]))
                rejected += 1
                worst = max(worst, 1)
                continue
            seen_ids[fid] = path
            entries.append((finding, path, n, line))
    where = dict((id(f), (p, n, line)) for f, p, n, line in entries)
    kept, dropped = dedupe([f for f, _, _, _ in entries])
    for f, instead in dropped:
        p, n, line = where[id(f)]
        lines.append("%s:%d: note [merge.duplicate] finding #%d (%s): same rule and location as %s in %s, dropped." % (
            p, line, n, f["id"], instead["id"], where[id(instead)][0]))
    lines.append("merged: %d finding%s from %d file%s: %s; %d duplicate%s dropped, %d rejected" % (
        len(kept), "" if len(kept) == 1 else "s", len(paths), "" if len(paths) == 1 else "s", tally_of(kept),
        len(dropped), "" if len(dropped) == 1 else "s", rejected))
    return worst, kept, lines


# ---------------------------------------------------------------------------
# --stats: count findings by rule across a repo's review records, and propose
# graduating a repeated, mechanical rule into a deterministic check (v0.7).
# Nothing here writes a file: proposals are printed for the user to decide on.
# ---------------------------------------------------------------------------

REVIEWS_GLOB = os.path.join("specs", "reviews", "*.json")

# Where each Graduates value would be enforced.
TARGETS = {
    "check": "the spec checker (orca-kit skills/spec/check), as a new rule",
    "secret_patterns": "the gate config (.orca-kit/spec-review.yml), secret_patterns, checked by the secrets gate",
    "risk_terms": "the gate config (.orca-kit/spec-review.yml), risk_terms, read by gate --risk",
}

# Words a draft term may not consist of alone: they appear in any sentence.
STOPWORDS = frozenset("""
a an the and or but nor if then when while given of to in on at for with by from into onto as is are was were be
been being it its this that these those there here not no so do does did should must will would can could may
might shall has have had i we you they he she them us our your their his her what which who whom all any each
every some such only than too very also just
""".split())
WORD_RE = re.compile(r"[a-z0-9]+(?:['’-][a-z0-9]+)*")
MAX_PHRASE = 3


def load_sibling(name):
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("spec_review_stats_" + name, os.path.join(HERE, name))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def find_root(start):
    """The nearest directory at or above start with .orca-kit/ or .git, else start."""
    d = os.path.abspath(start)
    while True:
        if os.path.exists(os.path.join(d, ".orca-kit")) or os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return os.path.abspath(start)
        d = parent


def read_records(root):
    """(worst exit code, problem lines, [(display path, record)] of the valid records), sorted by path."""
    record = load_sibling("record")
    worst, lines, records = 0, [], []
    for path in sorted(glob.glob(os.path.join(root, REVIEWS_GLOB))):
        shown = os.path.relpath(path, root).replace(os.sep, "/")
        code, out, data = record.check_file(path)
        if data is None:
            worst = max(worst, code)
            for line in out:
                lines.append(shown + line[len(path):] if line.startswith(path) else line)
            lines.append("%s: not counted: the record isn't valid" % shown)
            continue
        records.append((shown, data))
    return worst, lines, records


def count(records):
    """{rule: {"findings": n, "specs": [spec, ...], "examples": [(path, pass, finding)]}} over every pass.

    `examples` holds each spec's first finding of the rule, sorted by record path.

    Every pass of every record is counted (a record holds one review: a fresh
    review replaces its passes), and so is the set of specs a rule was seen
    in, which is what the threshold reads: one spec reviewed many times, or
    one noisy pass, is still one spec.
    """
    out = {}
    for shown, data in records:
        for n, p in enumerate(data.get("passes") or [], 1):
            for f in p["findings"]:
                c = out.setdefault(f["rule"], {"findings": 0, "specs": [], "examples": []})
                c["findings"] += 1
                if data["spec"] not in c["specs"]:
                    # One example per spec: its first finding of the rule.
                    c["specs"].append(data["spec"])
                    c["examples"].append((shown, n, f))
    for c in out.values():
        c["specs"].sort()
        c["examples"].sort(key=lambda e: e[0])
    return out


def evidence_by_spec(records, rule):
    """{spec: [evidence, ...]} of every finding of the rule, in record and pass order."""
    out = {}
    for _, data in records:
        for p in data.get("passes") or []:
            for f in p["findings"]:
                if f["rule"] == rule:
                    out.setdefault(data["spec"], []).append(f["evidence"])
    return out


def phrases(text):
    words = WORD_RE.findall(text.lower())
    out = set()
    for size in range(1, MAX_PHRASE + 1):
        for i in range(len(words) - size + 1):
            gram = words[i:i + size]
            if all(w in STOPWORDS for w in gram) or any(ch.isdigit() for w in gram for ch in w):
                continue
            out.add(" ".join(gram))
    return out


def draft_terms(by_spec, threshold):
    """[(term, specs)]: the literal phrases (1 to 3 words) the evidence of at least threshold specs shares.

    A phrase made only of common words, or holding a digit, isn't a term, and
    a phrase that contains a shorter term is dropped, since the term already
    matches wherever it does. Sorted by specs, most first, then by term.
    """
    seen = {}
    for spec, texts in by_spec.items():
        for gram in set().union(*(phrases(t) for t in texts)):
            seen.setdefault(gram, set()).add(spec)
    kept = sorted(g for g, specs in seen.items() if len(specs) >= threshold)
    terms = [g for g in kept
             if not any(o != g and re.search(r"(?:^| )%s(?: |$)" % re.escape(o), g) for o in kept)]
    return sorted(((t, len(seen[t])) for t in terms), key=lambda ts: (-ts[1], ts[0]))


def term_regex(terms, ignore_case=True):
    body = "|".join(r"\s+".join(re.escape(w) for w in t.split(" ")) for t in terms)
    return ("(?i)" if ignore_case else "") + r"\b(?:%s)\b" % body


def yaml_quote(text):
    return "'%s'" % text.replace("'", "''")


def draft_lines(rule, level, target, terms, findings, config, gate):
    """The draft check's lines for one proposal (indented), or a line saying there is no literal pattern."""
    if not terms:
        return ["  draft: none; the evidence shares no literal phrase across enough specs, so write the check from the examples"]
    out = ["  draft terms: " + ", ".join("%s (%d spec%s)" % (json.dumps(t), n, "" if n == 1 else "s") for t, n in terms)]
    words = [t for t, _ in terms]
    if target == "check":
        out.append("  draft regex: " + yaml_quote(term_regex(words)))
        where = "an AC, edge-case row or New: contract" if rule == "ambiguity.weasel-word" else "the spec's text"
        out.append("  draft rule: a checker %s when %s matches the regex" % ("error" if level == "blocker" else "warning", where))
    elif target == "secret_patterns":
        out.append("  draft config, added to any secret_patterns the repo has:")
        out.append("    secret_patterns:")
        out.extend("      - " + yaml_quote(p) for p in list(config["secret_patterns"]) + [term_regex(words, ignore_case=False)])
    elif target == "risk_terms":
        named = [f["risk"] for f in findings if f["risk"] is not None]
        if not named:
            out.append("  draft config: none; no finding names a risk, so the terms have no risk_terms entry to join")
            return out
        risk = max(sorted(set(named), key=gate.RISKS.index), key=named.count)
        current = config["risk_terms"].get(risk, gate.DEFAULT_RISK_TERMS[risk])
        # A term the current list already matches (backfill under 'backfill*') adds nothing.
        new = [t for t in words if gate.TERM_RE.match(t) and not any(gate.term_regex(c).search(t) for c in current)]
        if not new:
            out.append("  draft config: none; risk_terms.%s already matches every term" % risk)
            return out
        out.append("  draft config (risk_terms replaces a risk's defaults, so the list keeps the current terms):")
        out.append("    risk_terms:")
        out.append("      %s: [%s]" % (risk, ", ".join(yaml_quote(t) for t in list(current) + new)))
    return out


def stats_report(records, rows, threshold, config=None, gate=None):
    """(table lines, proposal lines, proposals) for valid records. Pure and deterministic."""
    counts = count(records)
    order = sorted(counts, key=lambda r: (-len(counts[r]["specs"]), -counts[r]["findings"], r))
    width = max([len("rule")] + [len(r) for r in order])
    table = ["%-*s  %-7s  %-15s  %8s  %5s" % (width, "rule", "level", "graduates", "findings", "specs")]
    for r in order:
        level, target = rows[r]
        table.append("%-*s  %-7s  %-15s  %8d  %5d" % (width, r, level, target, counts[r]["findings"], len(counts[r]["specs"])))
    proposals = [r for r in order if rows[r][1] != "no" and len(counts[r]["specs"]) >= threshold]
    lines = []
    for n, r in enumerate(proposals, 1):
        level, target = rows[r]
        c = counts[r]
        lines.append("graduate %d: %s (%s): seen in %d specs (%s), %d finding%s; enforce in %s" % (
            n, r, level, len(c["specs"]), ", ".join(c["specs"]), c["findings"], "" if c["findings"] == 1 else "s",
            TARGETS[target]))
        for shown, pass_no, f in c["examples"]:
            loc = f["location"]
            where = loc["section"] + ("" if loc["line"] is None else " line %d" % loc["line"]) + \
                ("" if loc["ref"] is None else " " + loc["ref"])
            lines.append("  example: %s pass %d, %s, %s: %s" % (shown, pass_no, f["id"], where, json.dumps(f["evidence"], ensure_ascii=False)))
        findings = [f for _, data in records for p in data.get("passes") or [] for f in p["findings"] if f["rule"] == r]
        terms = draft_terms(evidence_by_spec(records, r), threshold)
        lines.extend(draft_lines(r, level, target, terms, findings, config, gate))
    return table, lines, proposals


def stats(root):
    """(exit code, output lines) for `--stats`."""
    gate = load_sibling("gate")
    try:
        config, _ = gate.load_config(root)
    except gate.ConfigError as e:
        return 2, ["%s:%d: error [config] settings: %s. Fix: Correct the settings file; `gate --help` shows the format." % (
            gate.CONFIG_PATH.replace(os.sep, "/"), e.line or 1, e.message.rstrip("."))]
    worst, lines, records = read_records(root)
    threshold = config["graduate_after"]
    table, proposal_lines, proposals = stats_report(records, rule_rows(), threshold, config, gate)
    passes = sum(len(d.get("passes") or []) for _, d in records)
    total = sum(len(p["findings"]) for _, d in records for p in d.get("passes") or [])
    lines.extend(table)
    lines.extend(proposal_lines)
    not_counted = sum(1 for line in lines if line.endswith(": not counted: the record isn't valid"))
    lines.append("stats: %d record%s counted (%d pass%s, %d finding%s), %d not counted; %d proposal%s (graduate_after %d)" % (
        len(records), "" if len(records) == 1 else "s", passes, "" if passes == 1 else "es", total,
        "" if total == 1 else "s", not_counted, len(proposals), "" if len(proposals) == 1 else "s", threshold))
    return worst, lines


def parse_args(argv):
    opts = {"mode": "check", "paths": [], "repo": None}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            opts["mode"] = "help"
            return opts
        if arg == "--rules":
            opts["mode"] = "rules"
            return opts
        if arg in ("--merge", "--stats"):
            if opts["mode"] not in ("check", arg[2:]):
                raise UsageError("--merge and --stats can't be used together")
            opts["mode"] = arg[2:]
        elif arg == "--repo" or arg.startswith("--repo="):
            if arg == "--repo":
                if i + 1 >= len(argv):
                    raise UsageError("--repo needs a directory")
                i += 1
                opts["repo"] = argv[i]
            else:
                opts["repo"] = arg[len("--repo="):]
        elif arg == "--":
            opts["paths"].extend(argv[i + 1:])
            break
        elif arg.startswith("-") and arg != "-":
            raise UsageError("unknown option %r" % arg)
        else:
            opts["paths"].append(arg)
        i += 1
    if opts["mode"] == "stats":
        if opts["paths"]:
            raise UsageError("--stats reads every specs/reviews/*.json in the repo; give the repo with --repo, not files")
        return opts
    if opts["repo"] is not None:
        raise UsageError("--repo is only for --stats")
    if not opts["paths"]:
        raise UsageError("no findings files given")
    return opts


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts = parse_args(argv)
    except UsageError as e:
        sys.stderr.write("findings: %s\n%s\n" % (e, USAGE))
        return 2
    if opts["mode"] == "help":
        sys.stdout.write(__doc__.lstrip())
        return 0
    try:
        rule_table()
    except RuleTableError as e:
        sys.stderr.write("findings: can't read the rule table: %s\n" % e)
        return 2
    if opts["mode"] == "rules":
        for rule_id, text in RULE_TEXT.items():
            print("  %-26s error   %s" % (rule_id, text))
        print("with --merge:")
        for rule_id, text in MERGE_RULE_TEXT.items():
            print("  %-26s note    %s" % (rule_id, text[len("note: "):]))
        print("rule table (agents/spec-review-*.md):")
        for rule, level in sorted(rule_table().items()):
            print("  %-34s %s" % (rule, level))
        print("graduation candidates (the Graduates column, read by --stats):")
        for rule, (_, target) in sorted(rule_rows().items()):
            if target != "no":
                print("  %-34s %s" % (rule, target))
        return 0
    if opts["mode"] == "stats":
        root = opts["repo"] if opts["repo"] is not None else find_root(os.getcwd())
        if not os.path.isdir(root):
            sys.stderr.write("findings: --repo %s isn't a directory\n%s\n" % (root, USAGE))
            return 2
        code, lines = stats(os.path.abspath(root))
        for line in lines:
            print(line)
        return code
    if opts["mode"] == "merge":
        code, kept, lines = merge(opts["paths"])
        for line in lines:
            sys.stderr.write(line + "\n")
        sys.stdout.write(json.dumps(kept, indent=2, ensure_ascii=False) + "\n")
        return code
    worst = 0
    for path in opts["paths"]:
        code, lines = check_file(path)
        for line in lines:
            print(line)
        worst = max(worst, code)
    return worst


if __name__ == "__main__":
    sys.exit(main())
